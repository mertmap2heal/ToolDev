// Compliance Check – nested regulation folders and rules
model ComplianceRegulationFolder {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  name        String
  description String?
  purpose     String? // e.g. software airworthiness, DO-254 hardware
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   ComplianceRegulationFolder?  @relation("ComplianceFolderHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ComplianceRegulationFolder[] @relation("ComplianceFolderHierarchy")
  rules    ComplianceRule[]

  @@index([projectId])
  @@index([projectId, parentId])
}

model ComplianceRule {
  id          String   @id @default(uuid())
  projectId   String
  folderId    String?
  name        String
  standard    String // e.g. DO-178C, ISO 29148
  description String?
  checkType   String // e.g. requirement_has_acceptance_criteria, requirement_has_owner
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder   ComplianceRegulationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  findings ComplianceFinding[]

  @@index([projectId])
  @@index([folderId])
}

model ComplianceCheckRun {
  id        String   @id @default(uuid())
  projectId String
  name      String?
  status    String   @default("completed") // running | completed | failed
  ruleIds   String[] @default([]) // rule IDs included in this run
  createdAt DateTime @default(now())

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  findings ComplianceFinding[]

  @@index([projectId])
  @@index([createdAt])
}

model ComplianceFinding {
  id         String   @id @default(uuid())
  projectId  String
  runId      String
  ruleId     String
  status     String // pass | fail
  entityType String // requirement | function | parameter
  entityId   String?
  message    String?
  createdAt  DateTime @default(now())

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run     ComplianceCheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rule    ComplianceRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@index([runId])
  @@index([ruleId])
}

