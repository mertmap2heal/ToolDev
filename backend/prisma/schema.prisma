  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moc            VerMoc?                    @relation(fields: [linkedMocCode], references: [code], onDelete: SetNull)
  method         VerMethod?                 @relation(fields: [linkedMethodId], references: [id], onDelete: SetNull)
  testCaseSetups VerTestCaseSetup[]
