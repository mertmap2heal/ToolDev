generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  company   String?
  avatarUrl String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects ProjectMember[]
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  domain      String
  companyName String?
  progress    Float     @default(0)
  status      String    @default("active")
  deadline    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String

  teamMembers            ProjectMember[]
  requirements           Requirement[]
  functions              SystemFunction[]
  architectures          Architecture[]
  verifications          VerificationPlan[]
  documents              Document[]
  traceLinks             TraceLink[]
  issues                 Issue[]
  parameters             Parameter[]
  changeRequests         ChangeRequest[]
  savedViews             SavedView[]
  baselines              Baseline[]
  useCases               UseCase[]
  actors                 Actor[]
  requirementTemplates   RequirementTemplate[]
  diagrams               Diagram[]
  customRequirementTypes CustomRequirementType[]
  items                  Item[]
  verTestResults         VerTestResult[]
  tasks                  Task[]
  taskSavedViews         TaskSavedView[]
  boardColumns           BoardColumn[]
  taskTemplates          TaskTemplate[]
  verMethods             VerMethod[]
  verTestSetups          VerTestSetup[]
  verTestCases           VerTestCase[]
  verTestPlans           VerTestPlan[]
  verTestRuns            VerTestRun[]
  verEvidence            VerEvidence[]
  verReviews             VerReview[]
  verNonconformities     VerNonconformity[]
  verBaselines           VerBaseline[]
  verSettings            VerSettings?
  verAuditEvents         VerAuditEvent[]
  verTestCaseCustomSections VerTestCaseCustomSection[]
  verCustomOptions       VerCustomOption[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Requirement {
  id                 String    @id @default(uuid())
  projectId          String
  requirementId      String?   @unique
  title              String
  description        String
  parentId           String?
  priority           String
  status             String
  reviewStatus       String?   @default("draft") // 'draft' | 'under_review' | 'approved' | 'rejected'
  stage              String
  owner              String?
  verificationMethod String?
  acceptanceCriteria String?
  source             String?
  category           String?
  relatedDocuments   String[]  @default([])
  tags               String[]  @default([])
  requirementType    String? // functional, performance, interface, design_constraint, safety, security, usability, other
  requirementLevel   String? // system, subsystem, component, interface
  risk               String? // low, medium, high, critical
  complexity         String? // simple, moderate, complex
  rationale          String? // why the requirement exists
  assumptions        String? // assumptions related to the requirement
  dependencies       String[]  @default([]) // JSON array of requirement IDs this depends on
  conflicts          String[]  @default([]) // JSON array of conflicting requirement IDs
  stakeholders       String[]  @default([]) // JSON array of stakeholder names/IDs
  verificationStatus String? // not_verified, verified, failed
  verificationDate   DateTime?
  verificationNotes  String?
  linkedMocCode      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project     Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Requirement?            @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Requirement[]           @relation("RequirementHierarchy")
  comments    RequirementComment[]
  attachments RequirementAttachment[]
  reviews     RequirementReview[]
  moc         VerMoc?                 @relation(fields: [linkedMocCode], references: [code], onDelete: SetNull)

  @@unique([projectId, requirementId])
  @@index([projectId])
  @@index([parentId])
  @@index([linkedMocCode])
}

model RequirementComment {
  id            String   @id @default(uuid())
  requirementId String
  projectId     String
  content       String
  authorId      String?
  authorName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([projectId])
}

model RequirementAttachment {
  id             String   @id @default(uuid())
  requirementId  String
  projectId      String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  uploadedBy     String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([projectId])
}

model SystemFunction {
  id                 String   @id @default(uuid())
  projectId          String
  functionId         String?  @unique
  name               String
  description        String
  sourceReqId        String?
  status             String?  @default("draft")
  owner              String?
  verificationMethod String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parameters Parameter[]
}

model Architecture {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VerificationPlan {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TraceLink {
  id          String    @id @default(uuid())
  projectId   String
  sourceType  String
  sourceId    String
  targetType  String
  targetId    String
  linkType    String // satisfies, implements, verifies, derives, refines, copy, trace, allocate
  direction   String? // source → target relationship direction (for clarity)
  rationale   String? // why this relationship exists
  confidence  Float?
  isAuto      Boolean   @default(false)
  isSuspect   Boolean   @default(false)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  name      String
  type      String
  content   String?
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Issue {
  id                  String   @id @default(uuid())
  projectId           String
  title               String
  description         String
  priority            String   @default("medium")
  status              String   @default("open")
  owner               String?
  relatedFunctionIds  String[] @default([])
  relatedParameterIds String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Parameter {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  description      String?
  dataType         String?
  defaultValue     String?
  unit             String?
  sourceFunctionId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFunction SystemFunction? @relation(fields: [sourceFunctionId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
}

model ChangeRequest {
  id             String   @id @default(uuid())
  projectId      String
  title          String
  description    String
  sourceType     String // 'function' | 'issue' | 'parameter' | 'requirement'
  sourceId       String
  priority       String   @default("medium")
  status         String   @default("pending") // 'pending' | 'approved' | 'rejected' | 'in-review'
  requestedBy    String?
  reviewedBy     String?
  reviewComments String?
  risk           String? // 'low' | 'medium' | 'high' | 'critical'
  effort         String? // 'low' | 'medium' | 'high'
  justification  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments ChangeRequestAttachment[]
}

model ChangeRequestAttachment {
  id              String   @id @default(uuid())
  changeRequestId String
  projectId       String
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  uploadedBy      String?
  uploadedByName  String?
  createdAt       DateTime @default(now())

  changeRequest ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@index([projectId])
}

model SavedView {
  id        String   @id @default(uuid())
  projectId String
  userId    String?
  name      String
  type      String   @default("personal") // 'personal' | 'project' | 'organization'
  filters   String? // JSON string of filter criteria
  columns   String? // JSON string of column configuration
  sortBy    String?
  sortOrder String?
  viewpoint String? // stakeholder, system, verification, etc. (ISO/IEC/IEEE 42010)
  concerns  String? // what the view addresses
  viewType  String? // diagram, table, matrix, report
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([viewpoint])
}

model RequirementVersion {
  id                 String   @id @default(uuid())
  requirementId      String
  projectId          String
  version            Int
  title              String
  description        String
  priority           String
  status             String
  stage              String?
  owner              String?
  category           String?
  source             String?
  verificationMethod String?
  acceptanceCriteria String?
  tags               String[] @default([])
  changedBy          String?
  changedByName      String?
  changeReason       String?
  snapshot           String? // JSON string of full requirement data
  createdAt          DateTime @default(now())

  @@index([requirementId])
  @@index([projectId])
  @@index([version])
}

model Baseline {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  description   String?
  status        String    @default("active") // 'active' | 'locked' | 'archived'
  createdBy     String?
  createdByName String?
  lockedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items   BaselineItem[]
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BaselineItem {
  id            String   @id @default(uuid())
  baselineId    String
  requirementId String
  snapshot      String // JSON string of requirement data at baseline time
  createdAt     DateTime @default(now())

  baseline Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
  @@index([requirementId])
}

model UseCase {
  id                    String   @id @default(uuid())
  projectId             String
  useCaseId             String?  @unique
  name                  String
  description           String?
  actors                String[] @default([]) // JSON array of actor names
  preconditions         String?
  postconditions        String?
  mainFlow              String? // step-by-step main flow
  alternativeFlows      String? // JSON array of alternative flows
  extensions            String? // JSON array of extension flows
  priority              String? // low, medium, high, critical
  complexity            String? // simple, moderate, complex
  status                String?  @default("draft")
  relatedRequirementIds String[] @default([]) // JSON array of requirement IDs
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  useCaseActors UseCaseActor[]

  @@unique([projectId, useCaseId])
  @@index([projectId])
}

model Actor {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  type        String // primary, secondary, system
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  useCaseActors UseCaseActor[]

  @@unique([projectId, name])
  @@index([projectId])
}

model UseCaseActor {
  id        String @id @default(uuid())
  useCaseId String
  actorId   String

  useCase UseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  actor   Actor   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, actorId])
  @@index([useCaseId])
  @@index([actorId])
}

model RequirementTemplate {
  id              String   @id @default(uuid())
  projectId       String
  name            String
  description     String?
  requirementType String?
  category        String?
  templateFields  String? // JSON string of predefined field values
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([isDefault])
}

model Diagram {
  id                String   @id @default(uuid())
  projectId         String
  diagramType       String // req, bdd, ibd, par, act, seq, stm, uc, pkg, par-req
  name              String
  description       String?
  sourceElementId   String? // ID of the element this diagram was created from
  sourceElementType String? // requirement, function, useCase, parameter
  layout            Json? // Store node positions, zoom, etc.
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceElementId])
}

model CustomRequirementType {
  id        String   @id @default(uuid())
  projectId String
  typeName  String // The custom type name (e.g., "compliance", "regulatory")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, typeName])
  @@index([projectId])
}

model RequirementReview {
  id              String    @id @default(uuid())
  requirementId   String
  projectId       String
  reviewStatus    String    @default("draft") // 'draft' | 'in_review' | 'approved' | 'rejected' | 'cancelled'
  reviewType      String? // 'initial' | 'change' | 'periodic' | 'final'
  initiatedBy     String? // User ID who initiated the review
  initiatedByName String?
  startedAt       DateTime?
  completedAt     DateTime?
  reviewNotes     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  requirement Requirement           @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewers   RequirementReviewer[]

  @@index([requirementId])
  @@index([projectId])
  @@index([reviewStatus])
}

model RequirementReviewer {
  id             String    @id @default(uuid())
  reviewId       String
  requirementId  String
  projectId      String
  reviewerId     String? // User ID of the reviewer
  reviewerName   String? // Reviewer name (for external reviewers)
  reviewerEmail  String? // Reviewer email (for external reviewers)
  role           String? // 'reviewer' | 'approver' | 'observer'
  status         String    @default("pending") // 'pending' | 'in_progress' | 'approved' | 'rejected' | 'deferred'
  reviewComments String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  review RequirementReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([requirementId])
  @@index([projectId])
  @@index([reviewerId])
  @@index([status])
}

// ============================================
// INVENTORY MANAGEMENT SYSTEM MODELS
// ============================================

// Master Data
model ItemCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   ItemCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ItemCategory[] @relation("CategoryHierarchy")
  items    Item[]

  @@index([parentId])
}

model Uom {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items         Item[]
  ledgerEntries InventoryLedger[]
  poLines       PurchaseOrderLine[]
  soLines       SalesOrderLine[]

  @@index([code])
}

model Item {
  id             String   @id @default(uuid())
  sku            String   @unique
  name           String
  description    String?
  trackingPolicy String   @default("NONE") // NONE | LOT | SERIAL
  uomId          String
  categoryId     String?
  projectId      String? // Optional project association for hybrid scope
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  uom              Uom                   @relation(fields: [uomId], references: [id])
  category         ItemCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  project          Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  barcodes         BarcodeDefinition[]
  lots             Lot[]
  serialNumbers    SerialNumber[]
  balances         InventoryBalance[]
  ledgerEntries    InventoryLedger[]
  locationSettings ItemLocationSetting[]
  reservations     Reservation[]
  poLines          PurchaseOrderLine[]
  receiptLines     GoodsReceiptLine[]
  soLines          SalesOrderLine[]
  shipmentLines    ShipmentLine[]
  transferLines    TransferLine[]
  adjustmentLines  AdjustmentLine[]
  cycleCountLines  CycleCountLine[]
  costLayers       InventoryCostLayer[]

  @@index([sku])
  @@index([projectId])
  @@index([categoryId])
  @@index([isActive])
}

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([isActive])
}

model Customer {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders SalesOrder[]

  @@index([code])
  @@index([isActive])
}

model Warehouse {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  isActive            Boolean  @default(true)
  negativeStockPolicy String   @default("STRICT") // STRICT | ALLOW_WITH_WARNING
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  locations    Location[]
  transferFrom TransferOrder[] @relation("TransferFromWarehouse")
  transferTo   TransferOrder[] @relation("TransferToWarehouse")
  cycleCounts  CycleCount[]

  @@index([code])
  @@index([isActive])
}

model Location {
  id               String   @id @default(uuid())
  warehouseId      String
  code             String
  name             String?
  parentLocationId String?
  locationType     String? // BIN | ZONE | AISLE | RACK | SHELF
  pickingPriority  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent          Location?             @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  children        Location[]            @relation("LocationHierarchy")
  balances        InventoryBalance[]
  itemSettings    ItemLocationSetting[]
  ledgerFrom      InventoryLedger[]     @relation("LedgerFromLocation")
  ledgerTo        InventoryLedger[]     @relation("LedgerToLocation")
  receiptLines    GoodsReceiptLine[]
  shipmentLines   ShipmentLine[]
  transferFrom    TransferLine[]        @relation("TransferFromLocation")
  transferTo      TransferLine[]        @relation("TransferToLocation")
  adjustmentLines AdjustmentLine[]
  cycleCountLines CycleCountLine[]
  serialNumbers   SerialNumber[]
  reservations    Reservation[]
  costLayers      InventoryCostLayer[]
  poLines         PurchaseOrderLine[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([parentLocationId])
}

model ItemLocationSetting {
  id           String   @id @default(uuid())
  itemId       String
  locationId   String
  reorderPoint Decimal? @default(0)
  minQty       Decimal? @default(0)
  maxQty       Decimal?
  safetyStock  Decimal? @default(0)
  leadTimeDays Int?     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model BarcodeDefinition {
  id           String   @id @default(uuid())
  itemId       String
  barcodeValue String
  barcodeType  String   @default("CODE128") // CODE128 | EAN13 | QR | GS1_FUTURE
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([barcodeValue])
  @@index([itemId])
  @@index([isPrimary])
}

// Traceability
model Lot {
  id              String    @id @default(uuid())
  itemId          String
  lotCode         String
  manufactureDate DateTime?
  expiryDate      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  item            Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  ledgerEntries   InventoryLedger[]
  receiptLines    GoodsReceiptLine[]
  shipmentLines   ShipmentLine[]
  transferLines   TransferLine[]
  adjustmentLines AdjustmentLine[]
  cycleCountLines CycleCountLine[]
  costLayers      InventoryCostLayer[]
  allocations     ReservationAllocation[]

  @@unique([itemId, lotCode])
  @@index([itemId])
  @@index([lotCode])
  @@index([expiryDate])
}

model SerialNumber {
  id                String   @id @default(uuid())
  itemId            String
  serialCode        String
  status            String   @default("in_stock") // in_stock | allocated | shipped | scrapped
  currentLocationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item            Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location        Location?               @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  ledgerEntries   InventoryLedger[]
  receiptLines    GoodsReceiptLine[]
  shipmentLines   ShipmentLine[]
  transferLines   TransferLine[]
  adjustmentLines AdjustmentLine[]
  cycleCountLines CycleCountLine[]
  allocations     ReservationAllocation[]

  @@unique([itemId, serialCode])
  @@index([itemId])
  @@index([serialCode])
  @@index([status])
  @@index([currentLocationId])
}

// Inventory State
model InventoryBalance {
  id           String   @id @default(uuid())
  itemId       String
  locationId   String
  qtyOnHand    Decimal  @default(0)
  qtyReserved  Decimal  @default(0)
  qtyAvailable Decimal  @default(0) // Computed: qtyOnHand - qtyReserved
  updatedAt    DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model InventoryLedger {
  id             String   @id @default(uuid())
  occurredAt     DateTime @default(now())
  eventType      String // RECEIPT_POSTED | SHIPMENT_POSTED | TRANSFER_POSTED | ADJUSTMENT_POSTED | RESERVATION_CREATED | RESERVATION_RELEASED
  referenceType  String? // PURCHASE_ORDER | SALES_ORDER | TRANSFER_ORDER | ADJUSTMENT | CYCLE_COUNT | RESERVATION
  referenceId    String?
  itemId         String
  fromLocationId String?
  toLocationId   String?
  qtyDelta       Decimal
  uomId          String
  lotId          String?
  serialId       String?
  unitCost       Decimal?
  metadataJson   String? // JSON string for additional data
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation Location?     @relation("LedgerFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?     @relation("LedgerToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  lot          Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial       SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)
  uom          Uom           @relation(fields: [uomId], references: [id])

  @@index([itemId, occurredAt])
  @@index([fromLocationId, occurredAt])
  @@index([toLocationId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([idempotencyKey])
}

// Reservations
model Reservation {
  id            String   @id @default(uuid())
  itemId        String
  locationId    String?
  qtyReserved   Decimal
  status        String   @default("active") // active | released | fulfilled | cancelled
  referenceType String // SO_LINE | MANUAL
  referenceId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item        Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location    Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  allocations ReservationAllocation[]

  @@index([itemId])
  @@index([locationId])
  @@index([referenceType, referenceId])
  @@index([status])
}

model ReservationAllocation {
  id            String   @id @default(uuid())
  reservationId String
  lotId         String?
  serialId      String?
  qty           Decimal
  createdAt     DateTime @default(now())

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  lot         Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial      SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([lotId])
  @@index([serialId])
}

// Documents - Purchasing
model PurchaseOrder {
  id         String    @id @default(uuid())
  number     String    @unique
  supplierId String
  status     String    @default("Draft") // Draft | Approved | Sent | PartiallyReceived | Received | Closed | Cancelled
  orderedAt  DateTime  @default(now())
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([number])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id                   String   @id @default(uuid())
  purchaseOrderId      String
  itemId               String
  qtyOrdered           Decimal
  qtyReceived          Decimal  @default(0)
  unitPrice            Decimal
  uomId                String
  locationId           String
  trackingRequirements String? // JSON string for LOT/SERIAL requirements
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item               @relation(fields: [itemId], references: [id])
  uom           Uom                @relation(fields: [uomId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([itemId])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  number          String   @unique
  purchaseOrderId String?
  status          String   @default("Draft") // Draft | Posted | Cancelled
  receivedAt      DateTime @default(now())
  notes           String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@index([number])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([idempotencyKey])
}

model GoodsReceiptLine {
  id             String   @id @default(uuid())
  goodsReceiptId String
  poLineId       String?
  itemId         String
  qtyReceived    Decimal
  locationId     String
  lotId          String?
  serialId       String?
  unitCost       Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goodsReceipt GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  item         Item               @relation(fields: [itemId], references: [id])
  location     Location           @relation(fields: [locationId], references: [id])
  lot          Lot?               @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial       SerialNumber?      @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([goodsReceiptId])
  @@index([itemId])
  @@index([lotId])
  @@index([serialId])
}

// Documents - Sales
model SalesOrder {
  id         String    @id @default(uuid())
  number     String    @unique
  customerId String
  status     String    @default("Draft") // Draft | Approved | Allocated | PartiallyShipped | Shipped | Closed | Cancelled
  orderedAt  DateTime  @default(now())
  requiredAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  lines     SalesOrderLine[]
  shipments Shipment[]

  @@index([number])
  @@index([customerId])
  @@index([status])
}

model SalesOrderLine {
  id           String   @id @default(uuid())
  salesOrderId String
  itemId       String
  qtyOrdered   Decimal
  qtyAllocated Decimal  @default(0)
  qtyShipped   Decimal  @default(0)
  unitPrice    Decimal
  uomId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item           @relation(fields: [itemId], references: [id])
  uom        Uom            @relation(fields: [uomId], references: [id])
  shipments  ShipmentLine[]

  @@index([salesOrderId])
  @@index([itemId])
}

model Shipment {
  id             String    @id @default(uuid())
  number         String    @unique
  salesOrderId   String
  status         String    @default("Draft") // Draft | Picked | Packed | Posted | Cancelled
  shippedAt      DateTime?
  notes          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lines      ShipmentLine[]

  @@index([number])
  @@index([salesOrderId])
  @@index([status])
  @@index([idempotencyKey])
}

model ShipmentLine {
  id             String   @id @default(uuid())
  shipmentId     String
  soLineId       String
  itemId         String
  qtyShipped     Decimal
  fromLocationId String
  lotId          String?
  serialId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shipment     Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  soLine       SalesOrderLine @relation(fields: [soLineId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id])
  fromLocation Location       @relation(fields: [fromLocationId], references: [id])
  lot          Lot?           @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial       SerialNumber?  @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([itemId])
  @@index([lotId])
  @@index([serialId])
}

// Documents - Transfers
model TransferOrder {
  id              String   @id @default(uuid())
  number          String   @unique
  status          String   @default("Draft") // Draft | Approved | InTransit | Received | Cancelled
  fromWarehouseId String
  toWarehouseId   String
  notes           String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines         TransferLine[]

  @@index([number])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([idempotencyKey])
}

model TransferLine {
  id              String   @id @default(uuid())
  transferOrderId String
  itemId          String
  qty             Decimal
  fromLocationId  String
  toLocationId    String
  lotId           String?
  serialId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
  fromLocation  Location      @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation    Location      @relation("TransferToLocation", fields: [toLocationId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial        SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([transferOrderId])
  @@index([itemId])
}

// Documents - Adjustments
model StockAdjustment {
  id             String   @id @default(uuid())
  number         String   @unique
  status         String   @default("Draft") // Draft | Submitted | Approved | Posted | Cancelled
  reasonCode     String
  notes          String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines AdjustmentLine[]

  @@index([number])
  @@index([status])
  @@index([idempotencyKey])
}

model AdjustmentLine {
  id                String   @id @default(uuid())
  stockAdjustmentId String
  itemId            String
  locationId        String
  qtyDelta          Decimal // Positive for increase, negative for decrease
  lotId             String?
  serialId          String?
  unitCost          Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  lot             Lot?            @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial          SerialNumber?   @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([stockAdjustmentId])
  @@index([itemId])
}

// Documents - Cycle Counts
model CycleCount {
  id             String    @id @default(uuid())
  number         String    @unique
  status         String    @default("Planned") // Planned | Counting | Review | Approved | Posted | Cancelled
  warehouseId    String
  locationScope  String? // ALL | SPECIFIC_LOCATIONS (JSON array of location IDs)
  scheduledAt    DateTime?
  notes          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     CycleCountLine[]

  @@index([number])
  @@index([warehouseId])
  @@index([status])
  @@index([idempotencyKey])
}

model CycleCountLine {
  id           String   @id @default(uuid())
  cycleCountId String
  itemId       String
  locationId   String
  expectedQty  Decimal
  countedQty   Decimal
  varianceQty  Decimal // Computed: countedQty - expectedQty
  lotId        String?
  serialId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycleCount CycleCount    @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
  location   Location      @relation(fields: [locationId], references: [id])
  lot        Lot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  serial     SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([cycleCountId])
  @@index([itemId])
}

// FIFO Cost Layers
model InventoryCostLayer {
  id          String   @id @default(uuid())
  itemId      String
  locationId  String
  lotId       String?
  qty         Decimal
  unitCost    Decimal
  receivedAt  DateTime @default(now())
  consumedQty Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  lot      Lot?     @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([itemId, locationId, receivedAt])
  @@index([lotId])
}

// Support Tables
model InventoryAttachment {
  id         String   @id @default(uuid())
  entityType String // PURCHASE_ORDER | SALES_ORDER | TRANSFER_ORDER | ADJUSTMENT | CYCLE_COUNT | ITEM
  entityId   String
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())

  @@index([entityType, entityId])
}

model InventoryComment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([createdAt])
}

model InventoryApproval {
  id           String    @id @default(uuid())
  entityType   String
  entityId     String
  status       String    @default("Pending") // Pending | Approved | Rejected
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model InventoryAuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  beforeJson    String? // JSON string
  afterJson     String? // JSON string
  occurredAt    DateTime @default(now())
  correlationId String?
  userId        String?
  userName      String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

// ============================================
// TASK MANAGEMENT SYSTEM MODELS
// ============================================

// Core Tasks
model Task {
  id               String    @id @default(uuid())
  projectId        String?
  title            String
  descriptionRich  String?   @default("")
  status           String    @default("BACKLOG") // BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  startDate        DateTime?
  dueDate          DateTime?
  estimateMinutes  Int?
  blocked          Boolean   @default(false)
  blockedReason    String?
  parentTaskId     String?
  assignedToUserId String?
  sortOrder        Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent              Task?                @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children            Task[]               @relation("TaskHierarchy")
  tags                TaskTagLink[]
  checklists          Checklist[]
  comments            TaskComment[]
  attachments         TaskAttachment[]
  links               TaskLink[]
  relationsFrom       TaskRelation[]       @relation("FromTask")
  relationsTo         TaskRelation[]       @relation("ToTask")
  recurrenceRule      RecurrenceRule?
  recurrenceInstances RecurrenceInstance[]
  activityFeed        ActivityFeed[]
  timeLogs            TimeLog[]

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([assignedToUserId])
  @@index([projectId, status])
  @@index([projectId, dueDate])
}

// Tags
model TaskTag {
  id        String   @id @default(uuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())

  tasks TaskTagLink[]

  @@index([name])
}

model TaskTagLink {
  taskId String
  tagId  String

  task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

// Subtasks & Checklists
model Checklist {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([taskId])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  content     String
  isDone      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

// Comments & Mentions
model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  bodyRich   String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([taskId])
  @@index([createdAt])
}

model CommentMention {
  id                  String @id @default(uuid())
  commentId           String
  mentionedIdentifier String

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// Attachments & Links
model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  fileName   String
  storageKey String
  fileUrl    String
  sizeBytes  Int?
  mimeType   String?
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskLink {
  id        String   @id @default(uuid())
  taskId    String
  url       String
  title     String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Dependencies
model TaskRelation {
  id           String   @id @default(uuid())
  fromTaskId   String
  toTaskId     String
  relationType String // BLOCKS | BLOCKED_BY | RELATES | DUPLICATES | PARENT | CHILD
  createdAt    DateTime @default(now())

  fromTask Task @relation("FromTask", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("ToTask", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@index([fromTaskId])
  @@index([toTaskId])
  @@index([relationType])
}

// Recurrence
model RecurrenceRule {
  id        String   @id @default(uuid())
  taskId    String   @unique
  rruleText String
  timezone  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  task      Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  instances RecurrenceInstance[]

  @@index([taskId])
}

model RecurrenceInstance {
  id             String   @id @default(uuid())
  ruleId         String
  taskId         String
  occurrenceDate DateTime

  rule RecurrenceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  task Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([taskId])
  @@index([occurrenceDate])
}

// Views & Preferences
model TaskSavedView {
  id          String   @id @default(uuid())
  projectId   String?
  userId      String?
  name        String
  viewType    String // LIST | BOARD | CALENDAR | TIMELINE
  queryJson   String? // JSON string of filter criteria
  columnsJson String? // JSON string of column configuration
  sortJson    String? // JSON string of sort configuration
  groupJson   String? // JSON string of group-by configuration
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([userId])
}

model BoardColumn {
  id          String   @id @default(uuid())
  projectId   String?
  statusValue String
  name        String
  wipLimit    Int?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([projectId, statusValue])
  @@index([projectId])
}

// Automation
model AutomationRule {
  id             String   @id @default(uuid())
  name           String
  isActive       Boolean  @default(true)
  triggerType    String // task_created | status_changed | due_date_changed | comment_added | tag_added
  conditionsJson String // JSON string of condition tree
  actionsJson    String // JSON string of action list
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  runs AutomationRun[]

  @@index([isActive])
  @@index([triggerType])
}

model AutomationRun {
  id            String   @id @default(uuid())
  ruleId        String
  triggeredAt   DateTime @default(now())
  status        String // SUCCESS | FAILED | SKIPPED
  inputJson     String? // JSON string of trigger context
  outputJson    String? // JSON string of execution result
  correlationId String?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([triggeredAt])
  @@index([correlationId])
}

// Audit & Activity
model TaskAuditLog {
  id            String   @id @default(uuid())
  entityType    String   @default("TASK")
  entityId      String
  action        String // CREATE | UPDATE | DELETE | STATUS_CHANGE | etc.
  beforeJson    String? // JSON string snapshot
  afterJson     String? // JSON string snapshot
  occurredAt    DateTime @default(now())
  correlationId String?
  userId        String?
  userName      String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

model ActivityFeed {
  id            String   @id @default(uuid())
  taskId        String?
  eventType     String // task_created | status_changed | comment_added | etc.
  payloadJson   String // JSON string of event data
  occurredAt    DateTime @default(now())
  correlationId String?

  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([occurredAt])
  @@index([correlationId])
}

// Notifications (Placeholder)
model TaskNotification {
  id          String   @id @default(uuid())
  type        String
  payloadJson String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

// Time Tracking
model TimeLog {
  id              String   @id @default(uuid())
  taskId          String
  userId          String
  durationMinutes Int
  description     String?
  loggedAt        DateTime @default(now())
  billable        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@index([loggedAt])
}

// Task Templates
model TaskTemplate {
  id              String   @id @default(uuid())
  name            String
  description     String?
  title           String
  descriptionRich String?
  status          String?
  priority        String?
  estimateMinutes Int?
  tags            String[] // JSON array stored as String[]
  checklistItems  Json? // Array of checklist items
  projectId       String?
  isGlobal        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([isGlobal])
}

// ============================================
// VERIFICATION MODULE MODELS
// ============================================

// Means of Compliance Catalog
model VerMoc {
  code                         Int      @id // 0-8, primary key
  name                         String
  description                  String?
  requiresJustification        Boolean  @default(false)
  defaultRequiredEvidenceTypes Json? // JSON array of evidence types
  isActive                     Boolean  @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  methods      VerMethod[]
  testCases    VerTestCase[]
  requirements Requirement[]

  @@index([isActive])
}

// Verification Methods
model VerMethod {
  id                    String   @id @default(uuid())
  projectId             String
  name                  String
  methodType            String // TEST, ANALYSIS, INSPECTION, REVIEW, SIMULATION, DEMONSTRATION
  description           String?
  linkedMocCode         Int?
  applicablePhases      Json? // JSON array of phases
  requiredEvidenceTypes Json? // JSON array of evidence types
  ownerUserId           String?
  status                String   @default("DRAFT") // DRAFT, REVIEWED, APPROVED, DEPRECATED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moc       VerMoc?       @relation(fields: [linkedMocCode], references: [code], onDelete: SetNull)
  testCases VerTestCase[]

  @@index([projectId])
  @@index([linkedMocCode])
  @@index([status])
}

// Test Setup Library
model VerTestSetup {
  id                String   @id @default(uuid())
  projectId         String
  name              String
  description       String?
  environmentType   String // BENCH, HIL, SIL, GROUND, FLIGHT, OTHER
  components        Json? // JSON array of equipment, sensors, DUT, etc.
  interfaces        Json? // JSON array of ports, buses, connectors
  diagramData       Json? // Structured diagram (nodes/edges)
  diagramExportPath String? // Path to exported diagram file
  photos            Json? // JSON array of photo metadata
  version           String   @default("1.0")
  status            String   @default("DRAFT") // DRAFT, APPROVED, DEPRECATED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testCaseSetups VerTestCaseSetup[]
  testResults    VerTestResult[]

  @@index([projectId])
  @@index([status])
}

// Test Case Definitions
model VerTestCase {
  id               String   @id @default(uuid())
  projectId        String
  key              String // Unique key like "TC-UAV-001"
  title            String
  objective        String?
  preconditions    String?  @db.Text
  steps            Json? // JSON array of ordered steps
  expectedResults  Json? // JSON array of expected results
  passFailCriteria String?  @db.Text
  linkedMocCode    Int?
  linkedMethodId   String?
  ownerUserId      String?
  status           String   @default("DRAFT") // DRAFT, REVIEWED, APPROVED, READY
  version          String   @default("1.0")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moc            VerMoc?            @relation(fields: [linkedMocCode], references: [code], onDelete: SetNull)
  method         VerMethod?         @relation(fields: [linkedMethodId], references: [id], onDelete: SetNull)
  testCaseSetups VerTestCaseSetup[]
  planCases      VerTestPlanCase[]
  runResults     VerTestRunResult[]
  reverifyTasks  VerReverifyTask[]
  customSections VerTestCaseCustomSection[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([linkedMocCode])
  @@index([linkedMethodId])
  @@index([status])
}

// Join table: Test Case ↔ Setup
model VerTestCaseSetup {
  id         String   @id @default(uuid())
  testCaseId String
  setupId    String
  createdAt  DateTime @default(now())

  testCase VerTestCase  @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  setup    VerTestSetup @relation(fields: [setupId], references: [id], onDelete: Cascade)

  @@unique([testCaseId, setupId])
  @@index([testCaseId])
  @@index([setupId])
}

// Test Plan Container
model VerTestPlan {
  id            String   @id @default(uuid())
  projectId     String
  key           String // Unique key like "TP-UAV-001"
  name          String
  description   String?
  scope         String?  @db.Text
  entryCriteria String?  @db.Text
  exitCriteria  String?  @db.Text
  phase         String? // SRR, PDR, CDR, TRR, QUALIFICATION, CERTIFICATION, OTHER
  ownerUserId   String?
  status        String   @default("DRAFT") // DRAFT, REVIEWED, APPROVED, ACTIVE, CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planCases VerTestPlanCase[]
  testRuns  VerTestRun[]

  @@unique([projectId, key])
  @@index([projectId])
  @@index([status])
}

// Join table: Test Plan ↔ Test Cases
model VerTestPlanCase {
  id          String   @id @default(uuid())
  testPlanId  String
  testCaseId  String
  orderIndex  Int      @default(0)
  isMandatory Boolean  @default(true)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  testPlan VerTestPlan @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
  testCase VerTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@unique([testPlanId, testCaseId])
  @@index([testPlanId])
  @@index([testCaseId])
}

// Test Run Execution Instance
model VerTestRun {
  id               String    @id @default(uuid())
  projectId        String
  testPlanId       String?
  runName          String
  runNumber        Int?
  executedByUserId String?
  executionContext Json? // JSON: build version, config, tool versions
  startedAt        DateTime?
  endedAt          DateTime?
  status           String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, ABORTED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlan VerTestPlan?       @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  results  VerTestRunResult[]

  @@index([projectId])
  @@index([testPlanId])
  @@index([status])
}

// Test Run Result (per test case execution)
model VerTestRunResult {
  id                      String    @id @default(uuid())
  testRunId               String
  testCaseId              String
  testCaseVersionSnapshot Json // Immutable snapshot of test case at execution
  setupVersionSnapshot    Json? // Immutable snapshot of setup used
  resultStatus            String    @default("NOT_RUN") // NOT_RUN, PASS, FAIL, BLOCKED, SKIPPED
  actualResults           Json? // JSON or text
  notes                   String?   @db.Text
  executedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  testRun         VerTestRun         @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase        VerTestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nonconformities VerNonconformity[]

  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@index([resultStatus])
}

// Evidence Repository
model VerEvidence {
  id              String   @id @default(uuid())
  projectId       String
  evidenceType    String // TEST_REPORT, ANALYSIS_REPORT, CHECKLIST, LOG, IMAGE, SIM_OUTPUT, OTHER
  title           String
  description     String?
  storageRef      String // Path/URL/ID to actual file
  checksum        String? // File checksum for integrity
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links   VerEvidenceLink[]

  @@index([projectId])
  @@index([evidenceType])
}

// Polymorphic Evidence Linking
model VerEvidenceLink {
  id               String   @id @default(uuid())
  evidenceId       String
  linkedEntityType String // TEST_RUN, TEST_RUN_RESULT, TEST_CASE, TEST_SETUP, METHOD, REVIEW, NONCONFORMITY
  linkedEntityId   String
  relation         String   @default("PRIMARY") // PRIMARY, SUPPORTING
  createdAt        DateTime @default(now())

  evidence VerEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
  @@index([linkedEntityType, linkedEntityId])
}

// Test Results
model VerTestResult {
  id               String   @id @default(uuid())
  projectId        String
  title            String
  description      String?   @db.Text
  storageRef       String // Path/URL to actual file
  fileName         String
  fileSize         Int? // Size in bytes
  mimeType         String?
  checksum         String? // File checksum for integrity
  resultStatus     String   @default("NOT_RUN") // NOT_RUN, PASS, FAIL, BLOCKED, SKIPPED
  executedAt       DateTime?
  executedByUserId String?
  executedByName   String?
  testEnvironment  String?   @db.Text
  linkedSetupId    String?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  setup      VerTestSetup?      @relation(fields: [linkedSetupId], references: [id], onDelete: SetNull)
  links      VerTestResultLink[]

  @@index([projectId])
  @@index([resultStatus])
  @@index([executedAt])
  @@index([linkedSetupId])
}

// Test Result Linking (to Test Cases and Test Plans)
model VerTestResultLink {
  id               String   @id @default(uuid())
  testResultId     String
  linkedEntityType String // TEST_CASE or TEST_PLAN
  linkedEntityId   String
  relation         String   @default("PRIMARY") // PRIMARY, SUPPORTING
  createdAt        DateTime @default(now())

  testResult VerTestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([linkedEntityType, linkedEntityId])
}

// Formal Reviews
model VerReview {
  id              String    @id @default(uuid())
  projectId       String
  reviewType      String // TRR, QSR, CERT_REVIEW, OTHER
  title           String
  description     String?
  datePlanned     DateTime
  dateHeld        DateTime?
  status          String    @default("PLANNED") // PLANNED, IN_PROGRESS, CLOSED
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   VerReviewItem[]

  @@index([projectId])
  @@index([status])
}

// Review Items
model VerReviewItem {
  id                String    @id @default(uuid())
  reviewId          String
  entityType        String // REQUIREMENT, TEST_CASE, TEST_PLAN, TEST_RUN, METHOD, SETUP, EVIDENCE
  entityId          String
  findingSeverity   String? // NONE, MINOR, MAJOR
  findingText       String?   @db.Text
  actionOwnerUserId String?
  dueDate           DateTime?
  status            String    @default("OPEN") // OPEN, RESOLVED, CLOSED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  review VerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([entityType, entityId])
  @@index([status])
}

// Nonconformities
model VerNonconformity {
  id                    String   @id @default(uuid())
  projectId             String
  title                 String
  description           String?  @db.Text
  sourceTestRunResultId String?
  severity              String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                String   @default("OPEN") // OPEN, INVESTIGATING, FIXED, REVERIFY_REQUIRED, CLOSED
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceResult  VerTestRunResult? @relation(fields: [sourceTestRunResultId], references: [id], onDelete: SetNull)
  reverifyTasks VerReverifyTask[]

  @@index([projectId])
  @@index([sourceTestRunResultId])
  @@index([status])
  @@index([severity])
}

// Re-verification Tasks
model VerReverifyTask {
  id                 String    @id @default(uuid())
  nonconformityId    String
  testCaseId         String
  requiredRunContext Json? // JSON: required context for re-verification
  status             String    @default("PENDING") // PENDING, COMPLETED
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  nonconformity VerNonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)
  testCase      VerTestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([nonconformityId])
  @@index([testCaseId])
  @@index([status])
}

// Configuration Baselines
model VerBaseline {
  id              String   @id @default(uuid())
  projectId       String
  name            String
  description     String?
  baselineType    String // MILESTONE, CERTIFICATION, INTERNAL
  snapshot        Json // JSON: stores IDs + versions of ver artifacts
  createdByUserId String?
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([baselineType])
}

// Project-level Settings
model VerSettings {
  id                    String   @id @default(uuid())
  projectId             String   @unique
  allowedMocCodes       Json? // JSON array of allowed MoC codes
  mocRulesByCriticality Json? // JSON: rules by requirement criticality
  lifecycleRules        Json? // JSON: allowed transitions per entity
  namingRules           Json? // JSON: naming conventions
  permissionsMap        Json? // JSON: permission mappings
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Custom Dropdown Options
model VerCustomOption {
  id         String   @id @default(uuid())
  projectId  String
  optionType String // ENVIRONMENT_TYPE, COMPONENT_TYPE, INTERFACE_TYPE
  value      String
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, optionType, value])
  @@index([projectId, optionType])
}

// Audit Trail
model VerAuditEvent {
  id                String   @id @default(uuid())
  projectId         String
  entityType        String // Entity type (TEST_CASE, TEST_PLAN, etc.)
  entityId          String
  action            String // CREATE, UPDATE, DELETE, STATUS_CHANGE, LINK_EVIDENCE, UNLINK_EVIDENCE, APPROVE, DEPRECATE, CLOSE
  oldValue          Json? // JSON snapshot of old state
  newValue          Json? // JSON snapshot of new state
  performedByUserId String?
  performedAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([performedAt])
  @@index([action])
}

// Custom Sections for Test Cases
model VerTestCaseCustomSection {
  id          String   @id @default(uuid())
  testCaseId  String
  projectId   String
  title       String
  content     String   @db.Text // HTML content from rich text editor
  orderIndex  Int      @default(0) // For ordering sections
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCase    VerTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  images      VerTestCaseSectionImage[]

  @@index([testCaseId])
  @@index([projectId])
  @@index([orderIndex])
}

// Images for Custom Sections
model VerTestCaseSectionImage {
  id          String   @id @default(uuid())
  sectionId   String
  projectId   String
  fileName    String
  fileUrl     String   // Server URL path
  storageKey  String   // Filesystem storage key
  fileSize    Int      // Bytes
  mimeType    String?
  uploadedAt  DateTime @default(now())

  section     VerTestCaseCustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([projectId])
}
