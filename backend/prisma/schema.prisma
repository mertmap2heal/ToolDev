model CertObjective {
  id                  String   @id @default(uuid())
  projectId           String
  objId               String // e.g. OBJ-CS25-1309-01
  regRef              String
  title               String
  moc                 String // Test | Analysis | Inspection | Similarity | Simulation | Review
  status              String   @default("Open") // Open | Partial | Complete | Blocked
  criticality         String   @default("Medium") // Low | Medium | High
  linkedEvidenceCount Int      @default(0)
