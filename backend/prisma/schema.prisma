  updatedAt   DateTime @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     ParameterFolder?  @relation("ParameterFolderChildren", fields: [parentId], references: [id])
  children   ParameterFolder[] @relation("ParameterFolderChildren")
  parameters Parameter[]

  @@index([projectId])
  @@index([projectId, parentId])
}

// ── Communication Models ─────────────────────────────────────────────────────

/// A named communication bus or channel (e.g. "Vehicle CAN High", "Ground Uplink UDP").
model CommBus {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  protocol    String // can | ros | dds | xtce | mavlink | autosar | mqtt | custom
  config      Json? // protocol-specific config: { baudrate, namespace, domain, ... }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages CommMessage[]

  @@index([projectId])
}

/// A message/frame/topic definition on a CommBus.
model CommMessage {
  id          String   @id @default(uuid())
  busId       String
  name        String
  messageId   String? // CAN frame ID (hex), ROS topic, DDS topic, MAVLink msg ID, etc.
  direction   String? // publish | subscribe | send | receive | bidirectional
  description String?
  metadata    Json? // protocol-specific: { dlc, cycleTime, sender } for CAN; { queueSize, msgType } for ROS; etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bus    CommBus     @relation(fields: [busId], references: [id], onDelete: Cascade)
  fields CommField[]

  @@index([busId])
}

/// A signal/field within a CommMessage. May optionally link to a Parameter.
model CommField {
  id          String   @id @default(uuid())
  messageId   String
  parameterId String? // optional link — null for standalone fields (padding, counters, etc.)
  fieldName   String
  description String?
  dataType    String? // overrides parameter dataType if set
  order       Int      @default(0)
  config      Json? // protocol-specific: CAN { startBit, bitLength, scale, offset, byteOrder, valueType }; ROS { rosType }; etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  message   CommMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  parameter Parameter?  @relation(fields: [parameterId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([parameterId])
}

model ChangeRequest {
  id          String  @id @default(uuid())
  projectId   String
  crId        String? // Human readable ID (e.g. CR-001), unique per project
  title       String
  description String
  sourceType  String // 'function' | 'issue' | 'parameter' | 'requirement'
  sourceId    String
  priority    String  @default("medium")
  status      String  @default("pending") // 'pending' | 'approved' | 'rejected' | 'in-review'

  requestedBy String?
  owner       String?

  reviewedBy     String?
  reviewComments String?

  risk          String? // 'low' | 'medium' | 'high' | 'critical'
  effort        String? // 'low' | 'medium' | 'high'
  justification String?

  createdBy String?
  updatedBy String?

  createdAt DateTime @default(now())

  project          Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attachments      ChangeRequestAttachment[]
  requirementLinks RequirementChangeRequestLink[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@unique([projectId, crId], map: "ChangeRequest_projectId_crId_key")
  @@index([projectId])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([crId])
}

model ChangeRequestAttachment {
