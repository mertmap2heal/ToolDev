  @@index([projectId])
  @@index([resultStatus])
  @@index([executedAt])
  @@index([linkedSetupId])
  @@index([sourceTestRunId])
}

// Test Result Linking (to Test Cases and Test Plans)
model VerTestResultLink {
  id               String   @id @default(uuid())
  testResultId     String
  linkedEntityType String // TEST_CASE or TEST_PLAN
  linkedEntityId   String
  relation         String   @default("PRIMARY") // PRIMARY, SUPPORTING
  createdAt        DateTime @default(now())

  testResult VerTestResult @relation(fields: [testResultId], references: [id], onDelete: Cascade)

  @@index([testResultId])
  @@index([linkedEntityType, linkedEntityId])
}

// Formal Reviews
model VerReview {
  id              String    @id @default(uuid())
  projectId       String
  reviewType      String // TRR, QSR, CERT_REVIEW, OTHER
  title           String
  description     String?
  datePlanned     DateTime
  dateHeld        DateTime?
  status          String    @default("PLANNED") // PLANNED, IN_PROGRESS, CLOSED
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   VerReviewItem[]

  @@index([projectId])
  @@index([status])
}

// Review Items
model VerReviewItem {
  id                String    @id @default(uuid())
  reviewId          String
  entityType        String // REQUIREMENT, TEST_CASE, TEST_PLAN, TEST_RUN, METHOD, SETUP, EVIDENCE
  entityId          String
  findingSeverity   String? // NONE, MINOR, MAJOR
  findingText       String?   @db.Text
  actionOwnerUserId String?
  dueDate           DateTime?
  status            String    @default("OPEN") // OPEN, RESOLVED, CLOSED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  review VerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([entityType, entityId])
  @@index([status])
}

// Nonconformities
model VerNonconformity {
  id                    String   @id @default(uuid())
  projectId             String
  title                 String
  description           String?  @db.Text
  sourceTestRunResultId String?
  severity              String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                String   @default("OPEN") // OPEN, INVESTIGATING, FIXED, REVERIFY_REQUIRED, CLOSED
  createdByUserId       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceResult  VerTestRunResult? @relation(fields: [sourceTestRunResultId], references: [id], onDelete: SetNull)
  reverifyTasks VerReverifyTask[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId])
  @@index([sourceTestRunResultId])
  @@index([status])
  @@index([severity])
}

// Re-verification Tasks
model VerReverifyTask {
  id                 String    @id @default(uuid())
  nonconformityId    String
  testCaseId         String
  requiredRunContext Json? // JSON: required context for re-verification
  status             String    @default("PENDING") // PENDING, COMPLETED
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  nonconformity VerNonconformity @relation(fields: [nonconformityId], references: [id], onDelete: Cascade)
  testCase      VerTestCase      @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([nonconformityId])
  @@index([testCaseId])
  @@index([status])
}

// Configuration Baselines
model VerBaseline {
  id              String   @id @default(uuid())
  projectId       String
  name            String
  description     String?
  baselineType    String // MILESTONE, CERTIFICATION, INTERNAL
  snapshot        Json // JSON: stores IDs + versions of ver artifacts
  createdByUserId String?
  createdAt       DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([baselineType])
}

// Project-level Settings
model VerSettings {
  id                    String   @id @default(uuid())
  projectId             String   @unique
  allowedMocCodes       Json? // JSON array of allowed MoC codes
  mocRulesByCriticality Json? // JSON: rules by requirement criticality
