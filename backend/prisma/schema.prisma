  projectId              String   @unique
  version                String   @default("1.0")
  scopeSummary           String   @default("")
  complianceStrategyJson String? // JSON: reg -> strategy summary
  approvalStatus         String   @default("Draft") // Draft | UnderReview | Approved
  lastUpdated            DateTime @updatedAt
  createdAt              DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CertMilestone {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  date             DateTime
  type             String // PDR | CDR | TRR | TC submission | etc.
  status           String   @default("Planned") // Planned | Completed | Deferred
  relatedReviewId  String?
  relatedPackageId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([date])
}

model CertChecklist {
  id         String   @id @default(uuid())
  projectId  String
  name       String
  phase      String // PDR | CDR | TRR | etc.
  baselineId String?
  releaseId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items    CertChecklistItem[]
  signOffs CertSignOff[]

  @@index([projectId])
  @@index([phase])
}

model CertChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  description String   @default("")
  required    Boolean  @default(true)
  status      String   @default("Open") // Open | Complete
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  checklist CertChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model CertSignOff {
  id               String    @id @default(uuid())
  projectId        String
  checklistId      String?
  milestoneId      String?
  role             String    @default("")
  person           String    @default("")
  signedAt         DateTime?
  status           String    @default("Pending") // Pending | Signed | Delegated
  // Identity verification (issue #163): server-derived from authenticated session, never from client body
  signerId         String?
  assignedToUserId String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checklist  CertChecklist? @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  signer     User?          @relation("CertSignOffSigner", fields: [signerId], references: [id], onDelete: SetNull)
  assignedTo User?          @relation("CertSignOffAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId])
  @@index([checklistId])
  @@index([milestoneId])
  @@index([signerId])
  @@index([assignedToUserId])
}

// ═══════════════════════════════════════════════════════════════════════════
// TRANSITION CHECKLISTS — Mandatory validation checklists for lifecycle transitions
// ═══════════════════════════════════════════════════════════════════════════

model TransitionChecklist {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items       TransitionChecklistItem[]
  assignments ChecklistAssignment[]
  versions    ChecklistVersion[]

  @@index([projectId])
  @@index([projectId, isActive])
}

model TransitionChecklistItem {
  id               String   @id @default(uuid())
  checklistId      String
  sortOrder        Int      @default(0)
  label            String
  description      String?
  itemType         String   @default("BOOLEAN") // BOOLEAN | FIELD_VALIDATION | RULE_BASED | CONFIRMATION
  validationConfig Json? // { field, operator, value } for FIELD_VALIDATION; { rule } for RULE_BASED
  isRequired       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  checklist TransitionChecklist               @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  responses TransitionChecklistItemResponse[]
  issues    ChecklistItemIssue[]

  @@index([checklistId])
  @@index([checklistId, sortOrder])
}

model ChecklistAssignment {
  id           String   @id @default(uuid())
  checklistId  String
  projectId    String
  lifecycleId  String
  fromStatusId String
  toStatusId   String
  itemType     String   @default("Requirement")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checklist   TransitionChecklist   @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  completions ChecklistCompletion[]

  @@unique([projectId, lifecycleId, fromStatusId, toStatusId, checklistId])
  @@index([projectId, lifecycleId, fromStatusId, toStatusId, itemType])
  @@index([checklistId])
}

model ChecklistCompletion {
  id                    String    @id @default(uuid())
  checklistAssignmentId String
  entityType            String    @default("Requirement")
  entityId              String
  completedById         String?
  completedAt           DateTime  @default(now())
  overriddenById        String?
  overriddenAt          DateTime?
  passed                Boolean   @default(false)
  projectId             String

  assignment ChecklistAssignment               @relation(fields: [checklistAssignmentId], references: [id], onDelete: Cascade)
  project    Project                           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  responses  TransitionChecklistItemResponse[]

  @@index([checklistAssignmentId])
  @@index([entityType, entityId])
  @@index([projectId])
  @@index([completedById])
}

model TransitionChecklistItemResponse {
  id              String   @id @default(uuid())
  completionId    String
  checklistItemId String
  value           Json? // { checked: true } for BOOLEAN; { valid: true, message: "..." } for validations
  passed          Boolean  @default(false)
  respondedAt     DateTime @default(now())
  respondedById   String?

  completion    ChecklistCompletion     @relation(fields: [completionId], references: [id], onDelete: Cascade)
  checklistItem TransitionChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  respondedBy   User?                   @relation("ChecklistItemResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  comments      ChecklistItemComment[]
  issues        ChecklistItemIssue[]

  @@index([completionId])
  @@index([checklistItemId])
  @@index([respondedById])
}

model ChecklistVersion {
  id            String   @id @default(uuid())
  checklistId   String
  versionNumber Int
  snapshotJson  Json
  createdBy     String?
  createdAt     DateTime @default(now())

  checklist TransitionChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@unique([checklistId, versionNumber])
  @@index([checklistId])
}

model ChecklistItemComment {
  id         String   @id @default(uuid())
  responseId String
  projectId  String
  content    String
  authorId   String
  authorName String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  response TransitionChecklistItemResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  project  Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User                            @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([projectId])
  @@index([authorId])
}

model ChecklistItemIssue {
  id              String   @id @default(uuid())
  responseId      String?
  checklistItemId String
  issueId         String
  entityType      String   @default("Requirement")
  entityId        String
  projectId       String
  createdBy       String?
  createdAt       DateTime @default(now())

  response      TransitionChecklistItemResponse? @relation(fields: [responseId], references: [id], onDelete: SetNull)
  checklistItem TransitionChecklistItem          @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  issue         Issue                            @relation(fields: [issueId], references: [id], onDelete: Cascade)
  project       Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([checklistItemId, issueId, entityId])
  @@index([issueId])
  @@index([checklistItemId])
  @@index([entityId])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// AI-ready infrastructure (ai-ready-vision.md §6, §7). Parameters slice.
// ---------------------------------------------------------------------------

// Scoped API key issued to an MCP client for access to a single project.
// Revocable. Every tool call writes into AiInvocation so callers can be
// audited individually.
model ParameterMcpKey {
  id         String    @id @default(uuid())
  projectId  String
  issuedById String
  name       String
  keyHash    String    @unique
  scopes     String[] // ["read","draft","review","impact"] subset
  itarScope  Boolean   @default(false) // if true, may search itar-classified rows
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())

  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issuedBy     User           @relation(fields: [issuedById], references: [id], onDelete: Cascade)
  AiInvocation AiInvocation[]

  @@index([projectId])
  @@index([issuedById])
}

// Every AI invocation - REST `/ai/*` hit, MCP tool call, server-side AI
// job step - writes a row here. The export endpoint serves these in
// NDJSON form for ISO/IEC 42001 Annex B audits.
model AiInvocation {
  id            String   @id @default(uuid())
  projectId     String
  userId        String?
  agentKeyId    String?
  toolName      String // e.g. "mcp.list_parameters" | "rest.ai.draft"
  tier          String // "T0" | "T1" | "T2" | "T3" | "T4"
  model         String?
  modelVersion  String?
  promptId      String?
  contextHash   String?
  inputHash     String
  outputHash    String?
  contextTokens Int?
  outputTokens  Int?
  success       Boolean
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime @default(now())

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  agentKey ParameterMcpKey? @relation(fields: [agentKeyId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([toolName, createdAt])
}

// Background job runner (plan §2.1 item 15). Submit -> poll -> done.
// Keeps bulk operations out of the single-request timeout.
model ParameterBulkJob {
  id          String    @id @default(uuid())
  projectId   String
  submittedBy String
  operation   String // "bulk-status" | "bulk-delete" | "bulk-ai-draft" | ...
  payload     Json
  status      String    @default("pending") // pending | running | completed | failed | partial
  totalItems  Int       @default(0)
  doneItems   Int       @default(0)
  failedItems Int       @default(0)
  itemResults Json? // [{ id, status, error? }]
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  project         Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedByUser User    @relation(fields: [submittedBy], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([submittedBy, createdAt])
}

// BYOK — per-user encrypted AI provider API key. The plaintext key never
// leaves `aiCredentials.service.ts`; it is decrypted only for a single
// outbound call and zeroed from memory after use. `keyCiphertext` stores
// the AES-256-GCM envelope (iv || tag || ciphertext, base64). `keyMeta`
// carries non-secret hints the UI can display (masked tail, label).
model UserAiCredential {
  id            String    @id @default(uuid())
  userId        String
  provider      String // "anthropic" | "openai" | "azure" | "google" | "self_hosted"
  label         String // user-supplied friendly name
  keyCiphertext String // base64 AES-256-GCM envelope
  maskedTail    String // last 4 chars of the plaintext, for UI display
  scopes        String[] // optional, provider-agnostic ("draft","review","impact")
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([userId, revokedAt])
}

// Parameter-only baseline. Captures a point-in-time snapshot of every
// parameter in the project so authors can compare current state to a
// baseline and roll back on demand. Distinct from the requirements
// `Baseline` model — they live independently because they have different
// approval flows and snapshot shapes.
model ParameterBaseline {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())

  items   ParameterBaselineItem[]
  project Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ParameterBaselineItem {
  id          String   @id @default(uuid())
  baselineId  String
  parameterId String
  // Full Parameter row at baseline time (json). Restoring writes the
  // contained name / dataType / defaultValue / unit / status / formula
  // / etc back onto the live row, creating a new ParameterVersion in
  // the process.
  snapshot    Json
  createdAt   DateTime @default(now())

  baseline ParameterBaseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)

  @@index([baselineId])
  @@index([parameterId])
}

// Parameter scenarios — named what-if overlays. A scenario carries a
// list of (parameterId -> overrideValue) pairs that the UI overlays
// on top of the live parameter set when the scenario is "active".
// Pure projection — overlays never mutate the underlying parameter
// row. Serialised next to parameters.json on Git publish so consumers
// of the published file can replay a scenario offline.
model ParameterScenario {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides ParameterScenarioOverride[]
  project   Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId, createdAt])
}

model ParameterScenarioOverride {
  id          String   @id @default(uuid())
  scenarioId  String
  parameterId String
  // Override value as a string in the same encoding as
  // Parameter.defaultValue so the apply step is a flat string swap.
  value       String
  createdAt   DateTime @default(now())

  scenario ParameterScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, parameterId])
  @@index([scenarioId])
}

// =====================================================================
// Validation module — confirms the system meets stakeholder needs
// (distinct from Verification, which confirms it meets requirements).
// See .claude/proposals/01-validation.md for design.
// =====================================================================

model ValidationItem {
  id              String  @id @default(uuid())
  projectId       String
  key             String // VAL-001, atomic per project
  title           String
  description     String? @db.Text
  // DEMONSTRATION | OPERATIONAL_TEST | SIMULATION | ANALYSIS | STAKEHOLDER_ACCEPTANCE
  methodType      String  @default("DEMONSTRATION")
  // PDR | CDR | FAT | SAT | EIS | OTHER
  targetMilestone String  @default("OTHER")
  // PLANNED | EXECUTED | VALIDATED | BLOCKED | OBSOLETE
  status          String  @default("PLANNED")
  ownerUserId     String?
  // Inline criteria array: [{ id, text, outcome (MET|PARTIAL|NOT_MET|PENDING), notes, orderIndex }]
  criteria        Json    @default("[]")
  // Tags chosen from the project's ValidationSettings.tags library. Storing
  // labels (not ids) keeps each row self-describing.
  tags            String[] @default([])
  // Free-text priority bucket (low | medium | high | critical). String not
  // enum to match the Requirement.priority pattern.
  priority        String   @default("medium")
  // Optional target completion date.
  dueDate         DateTime?

  // Soft-delete (mirrors Requirement)
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  restoredAt   DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User                @relation("ValidationItemCreator", fields: [createdById], references: [id])
  owner     User?               @relation("ValidationItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  signOffs  ValidationSignOff[]
  stars     ValidationItemStar[]
  comments  ValidationComment[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([projectId, deletedAt])
  @@index([projectId, targetMilestone])
}

model ValidationItemStar {
  id               String   @id @default(uuid())
  userId           String
  validationItemId String
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  validationItem ValidationItem @relation(fields: [validationItemId], references: [id], onDelete: Cascade)

  @@unique([userId, validationItemId])
  @@index([validationItemId])
  @@index([userId])
}

model ValidationSettings {
  id        String   @id @default(uuid())
  projectId String   @unique
  // Custom key prefixes. JSON array of { prefix, label, description?, isDefault }.
  // The first or `isDefault:true` entry is what new items use unless the
  // creator picks a different one.
  prefixes  Json     @default("[{\"prefix\":\"VAL-\",\"label\":\"Validation\",\"description\":\"Default validation activities\",\"isDefault\":true}]")
  // Tag library. JSON array of { label, color }. Items pick tags from this
  // library; arbitrary free-text tags are not allowed so the set stays
  // navigable.
  tags      Json     @default("[]")
  // Project-shared criterion templates. JSON array of { label, criteria: string[] }.
  // Replaces the per-browser localStorage v1 so templates are visible to every
  // team member working in the same project.
  criterionTemplates Json @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Point-in-time snapshot of all live Validation items for a project. Created
/// by the design-system §8.3 "Baseline this state" action. The snapshot is
/// frozen Json so subsequent edits to the live items do not retroactively
/// change the baseline content. Compared / restored later via separate APIs.
model ValidationBaseline {
  id           String   @id @default(uuid())
  projectId    String
  label        String
  description  String?
  // Frozen array of item summaries. Shape: [{
  //   id, key, title, description, methodType, targetMilestone, status,
  //   priority, criteria, tags, ownerUserId, signOffCount, isSuspect
  // }]
  snapshot     Json
  itemCount    Int
  createdById  String
  createdAt    DateTime @default(now())
  // Soft delete (V-N9). Hard deletion of a certification anchor is wrong;
  // archived baselines remain queryable for audit and can be restored.
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ValidationBaselineCreatedBy", fields: [createdById], references: [id])
  deletedBy User?   @relation("ValidationBaselineDeletedBy", fields: [deletedById], references: [id])

  @@index([projectId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ValidationComment {
  id               String   @id @default(uuid())
  validationItemId String
  authorUserId     String
  body             String   @db.Text
  // Null = top-level comment; otherwise a threaded reply to another comment
  // on the SAME validation item.
  parentId         String?
  // Author-side edit is allowed; we keep history via updatedAt + audit log.
  // Hard delete is forbidden — set deletedAt instead so the thread stays
  // navigable and removed posts render as tombstones.
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  validationItem ValidationItem      @relation(fields: [validationItemId], references: [id], onDelete: Cascade)
  author         User                @relation(fields: [authorUserId], references: [id])
  parent         ValidationComment?  @relation("ValidationCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        ValidationComment[] @relation("ValidationCommentReplies")

  @@index([validationItemId, createdAt])
  @@index([authorUserId])
}

model ValidationSignOff {
  id               String  @id @default(uuid())
  validationItemId String
  signerUserId     String
  signerRoleLabel  String // free-text role e.g. "Customer Operations Lead"
  comment          String? @db.Text

  // Immutability: revocation creates a new row whose supersededById points
  // to the prior approval, marking it superseded. No row is ever updated.
  supersededById String?            @unique
  supersededBy   ValidationSignOff? @relation("SignOffSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  superseded     ValidationSignOff? @relation("SignOffSupersession")

  signedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  validationItem ValidationItem @relation(fields: [validationItemId], references: [id], onDelete: Cascade)
  signer         User           @relation(fields: [signerUserId], references: [id])

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([validationItemId])
  @@index([signerUserId])
}
