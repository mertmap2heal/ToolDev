  @@index([isActive])
}

model Supplier {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([code])
  @@index([isActive])
}

model Customer {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  zipCode     String?
  country     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrders SalesOrder[]

  @@index([code])
  @@index([isActive])
}

model Warehouse {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  address             String?
  city                String?
  state               String?
  zipCode             String?
  country             String?
  isActive            Boolean  @default(true)
  negativeStockPolicy String   @default("STRICT") // STRICT | ALLOW_WITH_WARNING
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  locations    Location[]
  transferFrom TransferOrder[] @relation("TransferFromWarehouse")
  transferTo   TransferOrder[] @relation("TransferToWarehouse")
  cycleCounts  CycleCount[]

  @@index([code])
  @@index([isActive])
}

model Location {
  id               String   @id @default(uuid())
  warehouseId      String
  code             String
  name             String?
  parentLocationId String?
  locationType     String? // BIN | ZONE | AISLE | RACK | SHELF
  pickingPriority  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse       Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent          Location?             @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: SetNull)
  children        Location[]            @relation("LocationHierarchy")
  balances        InventoryBalance[]
  itemSettings    ItemLocationSetting[]
  ledgerFrom      InventoryLedger[]     @relation("LedgerFromLocation")
  ledgerTo        InventoryLedger[]     @relation("LedgerToLocation")
  receiptLines    GoodsReceiptLine[]
  shipmentLines   ShipmentLine[]
  transferFrom    TransferLine[]        @relation("TransferFromLocation")
  transferTo      TransferLine[]        @relation("TransferToLocation")
  adjustmentLines AdjustmentLine[]
  cycleCountLines CycleCountLine[]
  serialNumbers   SerialNumber[]
  reservations    Reservation[]
  costLayers      InventoryCostLayer[]
  poLines         PurchaseOrderLine[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
  @@index([parentLocationId])
}

model ItemLocationSetting {
  id           String   @id @default(uuid())
  itemId       String
  locationId   String
  reorderPoint Decimal? @default(0)
  minQty       Decimal? @default(0)
  maxQty       Decimal?
  safetyStock  Decimal? @default(0)
  leadTimeDays Int?     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

model BarcodeDefinition {
  id           String   @id @default(uuid())
  itemId       String
  barcodeValue String
  barcodeType  String   @default("CODE128") // CODE128 | EAN13 | QR | GS1_FUTURE
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([barcodeValue])
  @@index([itemId])
  @@index([isPrimary])
}

model AuditLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
}

model ProjectAnalytics {
  id             String   @id @default(uuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id])
  totalTasks     Int      @default(0)
  completedTasks Int      @default(0)
  overdueTasks   Int      @default(0)
  lastCalculated DateTime @default(now())
}

model SerialNumber {
  id                String   @id @default(uuid())
  itemId            String
  serialCode        String
  status            String   @default("in_stock") // in_stock | allocated | shipped | scrapped
  currentLocationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  item            Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location        Location?               @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  ledgerEntries   InventoryLedger[]
  receiptLines    GoodsReceiptLine[]
  shipmentLines   ShipmentLine[]
  transferLines   TransferLine[]
  adjustmentLines AdjustmentLine[]
  cycleCountLines CycleCountLine[]
  allocations     ReservationAllocation[]

  @@unique([itemId, serialCode])
  @@index([itemId])
  @@index([serialCode])
  @@index([status])
  @@index([currentLocationId])
}

// Inventory State
model InventoryBalance {
  id           String   @id @default(uuid())
  itemId       String
  locationId   String
  qtyOnHand    Decimal  @default(0)
  qtyReserved  Decimal  @default(0)
  qtyAvailable Decimal  @default(0) // Computed: qtyOnHand - qtyReserved
  updatedAt    DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([itemId, locationId])
  @@index([itemId])
  @@index([locationId])
}

/// FIFO cost layers for inventory valuation (optional lot reference as opaque id until Lot model exists)
model InventoryCostLayer {
  id          String   @id @default(uuid())
  itemId      String
  locationId  String
  lotId       String?
  qty         Decimal
  consumedQty Decimal  @default(0)
  unitCost    Decimal
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([itemId])
  @@index([locationId])
  @@index([itemId, locationId, receivedAt])
}

model InventoryLedger {
  id             String   @id @default(uuid())
  occurredAt     DateTime @default(now())
  eventType      String // RECEIPT_POSTED | SHIPMENT_POSTED | TRANSFER_POSTED | ADJUSTMENT_POSTED | RESERVATION_CREATED | RESERVATION_RELEASED
  referenceType  String? // PURCHASE_ORDER | SALES_ORDER | TRANSFER_ORDER | ADJUSTMENT | CYCLE_COUNT | RESERVATION
  referenceId    String?
  itemId         String
  fromLocationId String?
  toLocationId   String?
  qtyDelta       Decimal
  uomId          String
  serialId       String?
  unitCost       Decimal?
  metadataJson   String? // JSON string for additional data
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromLocation Location?     @relation("LedgerFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location?     @relation("LedgerToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  serial       SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)
  uom          Uom           @relation(fields: [uomId], references: [id])

  @@index([itemId, occurredAt])
  @@index([fromLocationId, occurredAt])
  @@index([toLocationId, occurredAt])
  @@index([referenceType, referenceId])
  @@index([eventType])
  @@index([occurredAt])
  @@index([idempotencyKey])
}

// Reservations
model Reservation {
  id            String   @id @default(uuid())
  itemId        String
  locationId    String?
  qtyReserved   Decimal
  status        String   @default("active") // active | released | fulfilled | cancelled
  referenceType String // SO_LINE | MANUAL
  referenceId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item        Item                    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location    Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  allocations ReservationAllocation[]

  @@index([itemId])
  @@index([locationId])
  @@index([referenceType, referenceId])
  @@index([status])
}

model ReservationAllocation {
  id            String   @id @default(uuid())
  reservationId String
  serialId      String?
  qty           Decimal
  createdAt     DateTime @default(now())

  reservation Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serial      SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([serialId])
}

// Documents - Purchasing
model PurchaseOrder {
  id         String    @id @default(uuid())
  number     String    @unique
  supplierId String
  status     String    @default("Draft") // Draft | Approved | Sent | PartiallyReceived | Received | Closed | Cancelled
  orderedAt  DateTime  @default(now())
  expectedAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@index([number])
  @@index([supplierId])
  @@index([status])
}

model PurchaseOrderLine {
  id                   String   @id @default(uuid())
  purchaseOrderId      String
  itemId               String
  qtyOrdered           Decimal
  qtyReceived          Decimal  @default(0)
  unitPrice            Decimal
  uomId                String
  locationId           String
  trackingRequirements String? // JSON string for LOT/SERIAL requirements
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item               @relation(fields: [itemId], references: [id])
  uom           Uom                @relation(fields: [uomId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([itemId])
}

model GoodsReceipt {
  id              String   @id @default(uuid())
  number          String   @unique
  purchaseOrderId String?
  status          String   @default("Draft") // Draft | Posted | Cancelled
  receivedAt      DateTime @default(now())
  notes           String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  purchaseOrder PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@index([number])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([idempotencyKey])
}

model GoodsReceiptLine {
  id             String   @id @default(uuid())
  goodsReceiptId String
  poLineId       String?
  itemId         String
  qtyReceived    Decimal
  locationId     String
  serialId       String?
  unitCost       Decimal?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goodsReceipt GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine? @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  item         Item               @relation(fields: [itemId], references: [id])
  location     Location           @relation(fields: [locationId], references: [id])
  serial       SerialNumber?      @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([goodsReceiptId])
  @@index([itemId])
  @@index([serialId])
}

// Documents - Sales
model SalesOrder {
  id         String    @id @default(uuid())
  number     String    @unique
  customerId String
  status     String    @default("Draft") // Draft | Approved | Allocated | PartiallyShipped | Shipped | Closed | Cancelled
  orderedAt  DateTime  @default(now())
  requiredAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  lines     SalesOrderLine[]
  shipments Shipment[]

  @@index([number])
  @@index([customerId])
  @@index([status])
}

model SalesOrderLine {
  id           String   @id @default(uuid())
  salesOrderId String
  itemId       String
  qtyOrdered   Decimal
  qtyAllocated Decimal  @default(0)
  qtyShipped   Decimal  @default(0)
  unitPrice    Decimal
  uomId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item           @relation(fields: [itemId], references: [id])
  uom        Uom            @relation(fields: [uomId], references: [id])
  shipments  ShipmentLine[]

  @@index([salesOrderId])
  @@index([itemId])
}

model Shipment {
  id             String    @id @default(uuid())
  number         String    @unique
  salesOrderId   String
  status         String    @default("Draft") // Draft | Picked | Packed | Posted | Cancelled
  shippedAt      DateTime?
  notes          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  salesOrder SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lines      ShipmentLine[]

  @@index([number])
  @@index([salesOrderId])
  @@index([status])
  @@index([idempotencyKey])
}

model ShipmentLine {
  id             String   @id @default(uuid())
  shipmentId     String
  soLineId       String
  itemId         String
  qtyShipped     Decimal
  fromLocationId String
  serialId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  shipment     Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  soLine       SalesOrderLine @relation(fields: [soLineId], references: [id], onDelete: Cascade)
  item         Item           @relation(fields: [itemId], references: [id])
  fromLocation Location       @relation(fields: [fromLocationId], references: [id])
  serial       SerialNumber?  @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([shipmentId])
  @@index([itemId])
  @@index([serialId])
}

// Documents - Transfers
model TransferOrder {
  id              String   @id @default(uuid())
  number          String   @unique
  status          String   @default("Draft") // Draft | Approved | InTransit | Received | Cancelled
  fromWarehouseId String
  toWarehouseId   String
  notes           String?
  idempotencyKey  String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  fromWarehouse Warehouse      @relation("TransferFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse      @relation("TransferToWarehouse", fields: [toWarehouseId], references: [id])
  lines         TransferLine[]

  @@index([number])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@index([idempotencyKey])
}

model TransferLine {
  id              String   @id @default(uuid())
  transferOrderId String
  itemId          String
  qty             Decimal
  fromLocationId  String
  toLocationId    String
  serialId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  transferOrder TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
  fromLocation  Location      @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation    Location      @relation("TransferToLocation", fields: [toLocationId], references: [id])
  serial        SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([transferOrderId])
  @@index([itemId])
}

// Documents - Adjustments
model StockAdjustment {
  id             String   @id @default(uuid())
  number         String   @unique
  status         String   @default("Draft") // Draft | Submitted | Approved | Posted | Cancelled
  reasonCode     String
  notes          String?
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines AdjustmentLine[]

  @@index([number])
  @@index([status])
  @@index([idempotencyKey])
}

model AdjustmentLine {
  id                String   @id @default(uuid())
  stockAdjustmentId String
  itemId            String
  locationId        String
  qtyDelta          Decimal // Positive for increase, negative for decrease
  serialId          String?
  unitCost          Decimal?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockAdjustment StockAdjustment @relation(fields: [stockAdjustmentId], references: [id], onDelete: Cascade)
  item            Item            @relation(fields: [itemId], references: [id])
  location        Location        @relation(fields: [locationId], references: [id])
  serial          SerialNumber?   @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([stockAdjustmentId])
  @@index([itemId])
}

// Documents - Cycle Counts
model CycleCount {
  id             String    @id @default(uuid())
  number         String    @unique
  status         String    @default("Planned") // Planned | Counting | Review | Approved | Posted | Cancelled
  warehouseId    String
  locationScope  String? // ALL | SPECIFIC_LOCATIONS (JSON array of location IDs)
  scheduledAt    DateTime?
  notes          String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     CycleCountLine[]

  @@index([number])
  @@index([warehouseId])
  @@index([status])
  @@index([idempotencyKey])
}

model CycleCountLine {
  id           String   @id @default(uuid())
  cycleCountId String
  itemId       String
  locationId   String
  expectedQty  Decimal
  countedQty   Decimal
  varianceQty  Decimal // Computed: countedQty - expectedQty
  serialId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cycleCount CycleCount    @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
  location   Location      @relation(fields: [locationId], references: [id])
  serial     SerialNumber? @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([cycleCountId])
  @@index([itemId])
}

// Support Tables
model InventoryAttachment {
  id         String   @id @default(uuid())
  entityType String // PURCHASE_ORDER | SALES_ORDER | TRANSFER_ORDER | ADJUSTMENT | CYCLE_COUNT | ITEM
  entityId   String
  fileName   String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  uploadedAt DateTime @default(now())

  @@index([entityType, entityId])
}

model InventoryComment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  body       String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([createdAt])
}

model InventoryApproval {
  id           String    @id @default(uuid())
  entityType   String
  entityId     String
  status       String    @default("Pending") // Pending | Approved | Rejected
  requestedAt  DateTime  @default(now())
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

model InventoryAuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  beforeJson    String? // JSON string
  afterJson     String? // JSON string
  occurredAt    DateTime @default(now())
  correlationId String?
  userId        String?
  userName      String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

// ============================================
// TASK MANAGEMENT SYSTEM MODELS
// ============================================

// Core Tasks
model Task {
  id               String    @id @default(uuid())
  projectId        String?
  title            String
  descriptionRich  String?   @default("")
  status           String    @default("BACKLOG") // BACKLOG | TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority         String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  startDate        DateTime?
  dueDate          DateTime?
  estimateMinutes  Int?
  blocked          Boolean   @default(false)
  blockedReason    String?
  parentTaskId     String?
  assignedToUserId String?
  sortOrder        Float     @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project             Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent              Task?                @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  children            Task[]               @relation("TaskHierarchy")
  tags                TaskTagLink[]
  checklists          Checklist[]
  comments            TaskComment[]
  attachments         TaskAttachment[]
  links               TaskLink[]
  relationsFrom       TaskRelation[]       @relation("FromTask")
  relationsTo         TaskRelation[]       @relation("ToTask")
  recurrenceRule      RecurrenceRule?
  recurrenceInstances RecurrenceInstance[]
  activityFeed        ActivityFeed[]
  timeLogs            TimeLog[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([parentTaskId])
  @@index([assignedToUserId])
  @@index([projectId, status])
  @@index([projectId, dueDate])
}

// Tags
model TaskTag {
  // SEC-2 (#375): projectId added to scope tags per-tenant. Was globally
  // unique on `name` which (a) exposed the existence of cross-tenant rows
  // when a duplicate-name create errored with P2002, and (b) prevented two
  // tenants from coexisting with shared tag vocabulary ("blocker", "bug").
  // Backfilled via backfillTaskTagProjectId.ts. Tags used by tasks in
  // multiple projects are split into per-project copies; tags with no usage
  // remain projectId=null until an admin reconciles them.
  id        String   @id @default(uuid())
  name      String
  color     String?
  projectId String?
  createdAt DateTime @default(now())

  project Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   TaskTagLink[]

  @@unique([projectId, name])
  @@index([name])
  @@index([projectId])
}

model TaskTagLink {
  taskId String
  tagId  String

  task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

// Subtasks & Checklists
model Checklist {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  task  Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@index([taskId])
}

model ChecklistItem {
  id          String   @id @default(uuid())
  checklistId String
  content     String
  isDone      Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  checklist Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

// Comments & Mentions
model TaskComment {
  id         String   @id @default(uuid())
  taskId     String
  bodyRich   String
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentions CommentMention[]

  @@index([taskId])
  @@index([createdAt])
}

model CommentMention {
  id                  String @id @default(uuid())
  commentId           String
  mentionedIdentifier String

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// Attachments & Links
model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String
  fileName   String
  storageKey String
  fileUrl    String
  sizeBytes  Int?
  mimeType   String?
  createdAt  DateTime @default(now())

