}

model CertBaseline {
  id         String   @id @default(uuid())
  projectId  String
  baselineId String // e.g. BL-2026-03-PDR
  name       String
  status     String   @default("Draft")
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

