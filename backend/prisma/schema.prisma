// Automation
model AutomationRule {
  // SEC-2 (#375): projectId added to scope rules per-tenant. The previous
  // schema had no tenant column and `automation.routes.ts` applied only
  // authenticateToken - every authenticated user could list, create,
  // test-run, and view runs of every customer's automation rules.
  // Backfilled via backfillAutomationRuleProjectId.ts (walks
  // AutomationRun.inputJson -> Task.projectId). Rules with no traceable
  // project are flagged with projectId=null AND isActive=false so they
  // cannot fire against unintended projects during admin review.
  id             String   @id @default(uuid())
  name           String
  isActive       Boolean  @default(true)
  triggerType    String // task_created | status_changed | due_date_changed | comment_added | tag_added
  conditionsJson String // JSON string of condition tree
  actionsJson    String // JSON string of action list
  projectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs    AutomationRun[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([isActive])
  @@index([triggerType])
  @@index([projectId])
}

model AutomationRun {
  id            String   @id @default(uuid())
  ruleId        String
  triggeredAt   DateTime @default(now())
  status        String // SUCCESS | FAILED | SKIPPED
  inputJson     String? // JSON string of trigger context
  outputJson    String? // JSON string of execution result
  correlationId String?

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([triggeredAt])
  @@index([correlationId])
}

// Audit & Activity
model TaskAuditLog {
