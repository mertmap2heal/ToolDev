// Join table: Test Plan ↔ Setup
model VerTestPlanSetup {
  id         String   @id @default(uuid())
  testPlanId String
  setupId    String
  createdAt  DateTime @default(now())

  testPlan VerTestPlan  @relation(fields: [testPlanId], references: [id], onDelete: Cascade)
