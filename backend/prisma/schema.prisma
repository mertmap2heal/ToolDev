  beforeJson    String? // JSON string snapshot
  afterJson     String? // JSON string snapshot
  occurredAt    DateTime @default(now())
  correlationId String?
  userId        String?
  userName      String?

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([correlationId])
}

model ActivityFeed {
