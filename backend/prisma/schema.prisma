  exitCriteria             String?   @db.Text
  phase                    String? // SRR, PDR, CDR, TRR, QUALIFICATION, CERTIFICATION, OTHER
  ownerUserId              String?
  testingEnvironmentIds    Json? // Array of ENVIRONMENT_TYPE option values
  testingToolIds           Json? // Array of TESTING_TOOL option values
  status                   String    @default("DRAFT") // DRAFT, REVIEWED, APPROVED, ACTIVE, CLOSED
  // Document metadata (for structured PDF exports)
  docNumber                String? // e.g. TPL-10279003A-08-01
  docConfidentiality       String? // e.g. AMDC - INTERN
  docProjectCode           String? // e.g. I2403
  docRevision              String?   @default("1.0")
  docPlanDate              DateTime? // "Test Plan from ..."
  docPreparedByName        String?
  docQaByName              String?
  docApprovedByName        String?
  docApprovedAt            DateTime?
  docPurpose               String?   @db.Text
  docOverview              String?   @db.Text
  docStatementOfConformity String?   @db.Text
  docChangesPolicy         String?   @db.Text
  docDistribution          String?   @db.Text
  docAcronymsNote          String?   @db.Text
  docApplicableDocuments   Json? // Array<{ title: string; revision?: string; date?: string; publisher?: string }>
  docGeneralPrecautions    String?   @db.Text
  docGeneralConditions     Json? // free-form object/table data
  docTools                 Json? // Array<{ name: string; manufacturer?: string; partNumber?: string; serialNumber?: string; calibrationValidTill?: string }>
  docTestSetupNotes        String?   @db.Text
  docAppendices            Json? // Array<{ title: string; content: string }>
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planCases  VerTestPlanCase[]
  planSetups VerTestPlanSetup[]
  revisions  VerTestPlanRevision[]
  testRuns   VerTestRun[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@unique([projectId, key])
  @@index([projectId])
  @@index([status])
}

