generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  auditLogs                      AuditLog[]
  verEvidenceLinks               VerEvidenceLink[]
  id                             String            @id @default(uuid())
  email                          String            @unique
  inviteEmail                    String?           @unique
  name                           String
  company                        String?
  avatarUrl                      String?
  password                       String
  role                           String? // e.g. SUPERIOR_ADMIN; null = normal user
  lastLoginAt                    DateTime?
  mustChangePasswordOnFirstLogin Boolean           @default(false)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  projects                            ProjectMember[]
  ownedProjects                       Project[]                         @relation("ownedProjects")
  notifications                       Notification[]
  engineeringRoles                    UserEngineeringRole[]
  userAdminRoles                      UserAdminRole[]                   @relation("UserAdminRoleMember")
  projectUserEngineeringRoles         ProjectUserEngineeringRole[]      @relation("ProjectUserEngRoleMember")
  assignedProjectUserEngineeringRoles ProjectUserEngineeringRole[]      @relation("ProjectUserEngRoleAssigner")
  requirementSubscriptions            RequirementSubscription[]
  issueSubscriptions                  IssueSubscription[]
  issueComments                       IssueComment[]
  issueSystemNotes                    IssueSystemNote[]
  assignedIssues                      Issue[]                           @relation("IssueAssignee")
  createdIssues                       Issue[]                           @relation("IssueCreator")
  parameterVersions                   ParameterVersion[]
  checklistItemResponses              TransitionChecklistItemResponse[] @relation("ChecklistItemResponder")
  checklistItemComments               ChecklistItemComment[]
  certSignOffs                        CertSignOff[]                     @relation("CertSignOffSigner")
  certSignOffAssignments              CertSignOff[]                     @relation("CertSignOffAssignedTo")
  parameterMcpKeys                    ParameterMcpKey[]
  aiInvocations                       AiInvocation[]
  submittedBulkJobs                   ParameterBulkJob[]
  aiCredentials                       UserAiCredential[]
  validationItemsCreated              ValidationItem[]                  @relation("ValidationItemCreator")
  validationItemsOwned                ValidationItem[]                  @relation("ValidationItemOwner")
  validationSignOffs                  ValidationSignOff[]
  validationItemStars                 ValidationItemStar[]
  validationComments                  ValidationComment[]
  validationBaselinesCreated          ValidationBaseline[]              @relation("ValidationBaselineCreatedBy")
  validationBaselinesDeleted          ValidationBaseline[]              @relation("ValidationBaselineDeletedBy")
}

// Admin roles: permission templates (Viewer, Editor, Admin, etc.). Company-scoped via companyKey.
model AdminRole {
  id                 String   @id @default(uuid())
  companyKey         String   @default("__default__") // __default__ = shared/default roles
  name               String
  defaultPermissions Json // PermissionMap: { requirements: { view: true }, ... }
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userAdminRoles UserAdminRole[]

  @@unique([companyKey, name])
  @@index([companyKey])
}

// Junction table: many-to-many User <-> AdminRole (admin permission role assignments).
model UserAdminRole {
  id          String   @id @default(cuid())
  userId      String
  adminRoleId String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  user      User      @relation("UserAdminRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  adminRole AdminRole @relation(fields: [adminRoleId], references: [id], onDelete: Cascade)

  @@unique([userId, adminRoleId])
  @@index([userId])
  @@index([adminRoleId])
}

// Engineering roles: discipline-based roles (Systems Engineer, Test Engineer, etc.).
model EngineeringRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              UserEngineeringRole[]
  projectAssignments ProjectUserEngineeringRole[]
}

// Project-scoped engineering role assignments (single source of truth per project for discipline roles).
model ProjectUserEngineeringRole {
  id               String   @id @default(uuid())
  projectId        String
  userId           String
  roleId           String
  assignedByUserId String?
  createdAt        DateTime @default(now())

  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User            @relation("ProjectUserEngRoleMember", fields: [userId], references: [id], onDelete: Cascade)
  role       EngineeringRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?           @relation("ProjectUserEngRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, roleId])
  @@index([projectId])
  @@index([userId])
  @@index([roleId])
}

// Junction table: many-to-many User <-> EngineeringRole.
model UserEngineeringRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role EngineeringRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// Per-company user quota: max users (excluding SUPERIOR_ADMIN). companyKey = company name or __null__ for unnamed.
model CompanyLimit {
  id         String   @id @default(uuid())
  companyKey String   @unique
  maxUsers   Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Enterprise organization profile; one row per company (companyKey = name or __null__ for unnamed).
model Organization {
  id           String   @id @default(uuid())
  companyKey   String   @unique
  name         String
  displayName  String?
  description  String?
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  projectAnalytics     ProjectAnalytics?
  id                   String            @id @default(uuid())
  name                 String
  description          String?
  domain               String
  slug                 String            @unique
  companyName          String?
  progress             Float             @default(0)
  status               String            @default("active")
  deadline             DateTime?
  strictLifecycleGates Boolean?          @default(false)

  // AI feature flag (ai-ready-vision.md §5). Global env kill-switch
  // (FEATURES_AI_ENABLED) overrides this; this field is the per-project
  // opt-in that a project admin sets.
  aiEnabled       Boolean   @default(false)
  aiEnabledAt     DateTime?
  aiEnabledBy     String?
  // Optional per-project self-hosted OpenAI-compatible endpoint URL.
  // Slots into the provider precedence chain (see aiProvider/index.ts):
  //   BYOK -> project self-hosted -> env default. Used by air-gap or
  //   ITAR customers running their own llama.cpp / vLLM / Azure OpenAI.
  aiSelfHostedUrl String?

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  userId                      String
  user                        User                         @relation("ownedProjects", fields: [userId], references: [id])
  teamMembers                 ProjectMember[]
  requirements                Requirement[]
  functions                   SystemFunction[]
  architectures               Architecture[]
  verifications               VerificationPlan[]
  documents                   Document[]
  traceLinks                  TraceLink[]
  issues                      Issue[]
  parameters                  Parameter[]
  changeRequests              ChangeRequest[]
  savedViews                  SavedView[]
  savedViewFolders            SavedViewFolder[]
  savedViewRevisions          SavedViewRevision[]
  savedViewAuditEvents        SavedViewAuditEvent[]
  baselines                   Baseline[]
  useCases                    UseCase[]
  actors                      Actor[]
  requirementTemplates        RequirementTemplate[]
  requirementExportTemplates  RequirementExportTemplate[]
  exportJobs                  ExportJob[]
  corporateDocxTemplates      CorporateDocxTemplate[]
  excelColumnMappings         ExcelColumnMapping[]
  scheduledExports            ScheduledExport[]
  diagrams                    Diagram[]
  customRequirementTypes      CustomRequirementType[]
  parameterMcpKeys            ParameterMcpKey[]
  aiInvocations               AiInvocation[]
  parameterBulkJobs           ParameterBulkJob[]
  parameterBaselines          ParameterBaseline[]
  parameterScenarios          ParameterScenario[]
  items                       Item[]
  verTestResults              VerTestResult[]
  tasks                       Task[]
  taskTags                    TaskTag[]
  taskSavedViews              TaskSavedView[]
  automationRules             AutomationRule[]
  auditLogs                   AuditLog[]
  boardColumns                BoardColumn[]
  taskTemplates               TaskTemplate[]
  verMethods                  VerMethod[]
  verTestSetups               VerTestSetup[]
  verTestCases                VerTestCase[]
  verTestPlans                VerTestPlan[]
  verTestPlanRevisions        VerTestPlanRevision[]
  verTestRuns                 VerTestRun[]
  verTestProcedures           VerTestProcedure[]
  verTestEnvironments         VerTestEnvironment[]
  verTestLogs                 VerTestLog[]
  verEvidence                 VerEvidence[]
  verReviews                  VerReview[]
  verNonconformities          VerNonconformity[]
  verBaselines                VerBaseline[]
  verSettings                 VerSettings?
  verAuditEvents              VerAuditEvent[]
  verTestCaseCustomSections   VerTestCaseCustomSection[]
  verTestCaseSectionImages    VerTestCaseSectionImage[]
  verCustomOptions            VerCustomOption[]
  verTemplates                VerTemplate[]
  complianceRules             ComplianceRule[]
  complianceRegulationFolders ComplianceRegulationFolder[]
  complianceCheckRuns         ComplianceCheckRun[]
  complianceFindings          ComplianceFinding[]
  components                  Component[]
  certContext                 CertContext?
  certBaselines               CertBaseline[]
  certReleases                CertRelease[]
  certObjectives              CertObjective[]
  certComplianceMatrixRows    CertComplianceMatrixRow[]
  certFindings                CertFinding[]
  certReviewLogEntries        CertReviewLogEntry[]
  certActivityLogEntries      CertActivityLogEntry[]
  certReadinessGates          CertReadinessGate[]
  certPackages                CertPackage[]
  certCorrespondences         CertCorrespondence[]
  certMeetings                CertMeeting[]
  certPlan                    CertPlan?
  certMilestones              CertMilestone[]
  certChecklists              CertChecklist[]
  certSignOffs                CertSignOff[]
  transitionChecklists        TransitionChecklist[]
  checklistAssignments        ChecklistAssignment[]
  checklistCompletions        ChecklistCompletion[]
  checklistItemComments       ChecklistItemComment[]
  checklistItemIssues         ChecklistItemIssue[]
  definitionEntries           DefinitionEntry[]
  parameterTypes              ParameterType[]
  projectUnits                ProjectUnit[]
  commBuses                   CommBus[]
  projectUserEngineeringRoles ProjectUserEngineeringRole[]
  parameterFolders            ParameterFolder[]
  validationItems             ValidationItem[]
  validationSettings          ValidationSettings?
  validationBaselines         ValidationBaseline[]
}

// Requirements export templates (ExportBuilder) - enterprise export wizard presets.
// Stored server-side for cross-device availability.
model RequirementExportTemplate {
  id          String    @id @default(uuid())
  projectId   String
  name        String
  format      String // csv | excel | pdf | word | reqif
  payload     Json // full template config (columns, scope, filters, sections, documentStyle, etc.)
  visibility  String    @default("project") // private | project | org
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, format])
  @@index([projectId, visibility])
  @@index([deletedAt])
  // Composite index for soft-delete list queries (#39)
  @@index([projectId, deletedAt])
}

// Background export jobs – track client-initiated large exports (>500 reqs) for progress monitoring.
model ExportJob {
  id          String   @id @default(uuid())
  projectId   String
  createdById String?
  format      String // csv | excel | pdf | word | reqif
  status      String   @default("pending") // pending | running | done | failed
  progress    Int      @default(0) // 0-100
  totalCount  Int      @default(0)
  doneCount   Int      @default(0)
  label       String? // human-readable label e.g. "All reqs – PDF export"
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
  @@index([createdById])
}

// Corporate DOCX template upload – users can upload branded .docx files with {placeholder} tags.
model CorporateDocxTemplate {
  id           String   @id @default(uuid())
  projectId    String
  name         String
  description  String?
  fileBase64   String // Base64-encoded .docx file
  placeholders String? // JSON array of placeholder names found in the template
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

// Excel column mapping presets – map system fields to specific named columns or ranges in a corporate spreadsheet.
model ExcelColumnMapping {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String?
  mappings    Json // Array of { systemField: string; excelColumn: string; namedRange?: string }
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

// Scheduled export hooks – config storage for future automation; no actual scheduling engine.
model ScheduledExport {
  id            String    @id @default(uuid())
  projectId     String
  name          String
  description   String?
  templateId    String? // optional reference to RequirementExportTemplate.id
  scheduleExpr  String? // cron expression placeholder (not executed server-side yet)
  format        String    @default("pdf") // csv | excel | pdf | word | reqif
  enabled       Boolean   @default(false)
  lastRunAt     DateTime?
  lastRunStatus String? // pending | done | failed
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([projectId, enabled])
}

model Component {
  id          String   @id @default(uuid())
  projectId   String
  parentId    String?
  name        String
  pbsCode     String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Component?    @relation("ComponentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Component[]   @relation("ComponentHierarchy")
  requirements Requirement[]

  @@index([projectId])
  @@index([parentId])
}

model DefinitionEntry {
  id          String   @id @default(uuid())
  projectId   String
  type        String // glossary | abbreviation
  term        String
  definition  String // rich text / HTML
  notes       String?
  source      String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, term])
  @@index([projectId])
  @@index([projectId, type])
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String
  status    String   @default("accepted") // pending | accepted
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String // project_invitation
  title     String
  message   String
  projectId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
}

model Requirement {
  id                 String    @id @default(uuid())
  projectId          String
  requirementId      String?
  title              String
  description        String
  parentId           String?
  componentId        String?
  priority           String
  status             String
  reviewStatus       String?   @default("draft") // 'draft' | 'under_review' | 'approved' | 'rejected'
  stage              String
  owner              String?
  verificationMethod String?
  acceptanceCriteria String?
  source             String?
  category           String?
  relatedDocuments   String[]  @default([])
  tags               String[]  @default([])
  requirementType    String? // functional, performance, interface, design_constraint, safety, security, usability, other
  requirementLevel   String? // system, subsystem, component, interface
  risk               String? // low, medium, high, critical
  complexity         String? // simple, moderate, complex
  rationale          String? // why the requirement exists
  assumptions        String? // assumptions related to the requirement
  dependencies       String[]  @default([]) // JSON array of requirement IDs this depends on
  conflicts          String[]  @default([]) // JSON array of conflicting requirement IDs
  stakeholders       String[]  @default([]) // JSON array of stakeholder names/IDs
  verificationStatus String? // not_verified, verified, failed
  verificationDate   DateTime?
  verificationNotes  String?
  linkedMocCode      Int?

  // Premium / Extended Fields
  thresholdValue   String? // for performance requirements
  objectiveValue   String? // for performance requirements
  customAttributes Json? // key-value pairs for extendable properties

  // Locking mechanism
  isLocked       Boolean   @default(false)
  lockedByUserId String?
  lockedAt       DateTime?

  lifecycleId     String?
  statusId        String?
  statusChangedAt DateTime?
  statusChangedBy String?

  // Soft delete fields
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?
  restoredAt   DateTime?
  restoredById String?

  // Optimistic locking — increment on every write; client must echo current value
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project            Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent             Requirement?                   @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Requirement[]                  @relation("RequirementHierarchy")
  component          Component?                     @relation(fields: [componentId], references: [id], onDelete: SetNull)
  comments           RequirementComment[]
  attachments        RequirementAttachment[]
  reviews            RequirementReview[]
  moc                VerMoc?                        @relation(fields: [linkedMocCode], references: [code], onDelete: SetNull)
  certObjectiveLinks CertObjectiveRequirementLink[]
  changeRequestLinks RequirementChangeRequestLink[]
  subscriptions      RequirementSubscription[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@unique([projectId, requirementId])
  @@index([projectId])
  @@index([parentId])
  @@index([componentId])
  @@index([linkedMocCode])
  // Composite index for soft-delete list queries (projectId always in WHERE) (#39)
  @@index([projectId, deletedAt])
  // FK fields without indexes — speeds up join/filter queries on these columns (#40)
  @@index([lockedByUserId])
  @@index([statusId])
  @@index([statusChangedBy])
  @@index([deletedById])
}

model RequirementSubscription {
  id             String    @id @default(uuid())
  requirementId  String
  userId         String
  createdAt      DateTime  @default(now())
  lastNotifiedAt DateTime?

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requirementId, userId])
  @@index([requirementId])
  @@index([userId])
}

model RequirementComment {
  id            String   @id @default(uuid())
  requirementId String
  projectId     String
  content       String
  authorId      String?
  authorName    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([projectId])
}

model RequirementAttachment {
  id             String   @id @default(uuid())
  requirementId  String
  projectId      String
  fileName       String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  uploadedBy     String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@index([requirementId])
  @@index([projectId])
}

model SystemFunction {
  id                 String   @id @default(uuid())
  projectId          String
  functionId         String?  @unique
  name               String
  description        String
  sourceReqId        String?
  status             String?  @default("draft")
  owner              String?
  verificationMethod String?
  parentId           String?
  level              Int      @default(0)
  sortOrder          Int      @default(0)
  criticality        String?  @default("medium")
  pbsComponentId     String?
  allocatedTo        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     SystemFunction?  @relation("FunctionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   SystemFunction[] @relation("FunctionHierarchy")
  parameters Parameter[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId])
  @@index([projectId, pbsComponentId])
}

model Architecture {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model VerificationPlan {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model TraceLink {
  id                    String    @id @default(uuid())
  projectId             String
  sourceType            String
  sourceId              String
  targetType            String
  targetId              String
  linkType              String // satisfies, implements, verifies, derives, refines, copy, trace, allocate
  direction             String? // source → target relationship direction (for clarity)
  rationale             String? // why this relationship exists
  confidence            Float?
  createdBy             String?
  isAuto                Boolean   @default(false)
  isSuspect             Boolean   @default(false)
  lastChecked           DateTime?
  createdAt             DateTime  @default(now())
  // Denormalized display snapshots (migration 20260322160000_trace_link_display_cache)
  cachedSourceDisplayId String?   @db.VarChar(255)
  cachedSourceTitle     String?   @db.VarChar(1024)
  cachedTargetDisplayId String?   @db.VarChar(255)
  cachedTargetTitle     String?   @db.VarChar(1024)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId, linkType])
  @@index([projectId, sourceType, targetType, linkType])
  @@index([projectId, targetId, linkType])
}

model Document {
  id        String   @id @default(uuid())
  projectId String
  name      String
  type      String
  content   String?
  sections  Json?
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?
}

model Issue {
  id                  String    @id @default(uuid())
  projectId           String
  issueKey            String?   @unique // e.g., ISS-0001
  title               String
  description         String
  priority            String    @default("medium")
  status              String    @default("open")
  issueType           String? // Problem Report classification: specification_error, design_error, coding_error, documentation_error, interface_error, other
  owner               String?
  assigneeId          String?
  createdBy           String?
  updatedBy           String?
  closedAt            DateTime?
  closedBy            String?
  relatedFunctionIds  String[]  @default([])
  relatedParameterIds String[]  @default([])
  labelIds            String[]  @default([])
  startDate           DateTime?
  dueDate             DateTime?
  estimatedTime       String? // e.g., "2h", "1d"
  actualTime          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee            User?                @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdByUser       User?                @relation("IssueCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  comments            IssueComment[]
  systemNotes         IssueSystemNote[]
  subscriptions       IssueSubscription[]
  links               IssueLink[]          @relation("IssueToLink")
  attachments         IssueAttachment[]
  checklistItemIssues ChecklistItemIssue[]

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId])
  @@index([issueKey])
  @@index([status])
  @@index([assigneeId])
  @@index([projectId, status])
  @@index([assigneeId, status])
  @@index([relatedFunctionIds(ops: ArrayOps)], type: Gin)
}

model IssueComment {
