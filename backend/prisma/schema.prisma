// Test Run Execution Instance
model VerTestRun {
  id                    String    @id @default(uuid())
  projectId             String
  testPlanId            String?
  runName               String
  runNumber             Int?
  executedByUserId      String?
  executionContext      Json? // JSON: build version, config, tool versions
  startedAt             DateTime?
  endedAt               DateTime?
  status                String    @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, ABORTED
  environmentId         String?
  actualDurationSeconds Int?
  pausedAt              DateTime?
  deletedAt             DateTime? // Soft-delete only; hard delete forbidden for audit compliance
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project             Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testPlan            VerTestPlan?               @relation(fields: [testPlanId], references: [id], onDelete: SetNull)
  environment         VerTestEnvironment?        @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  results             VerTestRunResult[]
  testLog             VerTestLog?
  timerSegments       VerTestRunExecutionTimer[]
  exportedTestResults VerTestResult[] // Test results exported from this run

  // AI-provenance lattice (R-1; ai-ready-vision.md section 6.1)
  authorType             String    @default("human")
  authorAiModel          String?
  authorAiVersion        String?
  authorAiPromptId       String?
  authorAiContextHash    String?
  provenanceReviewStatus String    @default("drafted")
  reviewerUserId         String?
  reviewTimestamp        DateTime?

  @@index([projectId])
  @@index([environmentId])
  @@index([testPlanId])
  @@index([status])
  @@index([deletedAt])
}

// Test Run Result (per test case execution)
model VerTestRunResult {
  id                               String    @id @default(uuid())
  testRunId                        String
  testCaseId                       String
  testCaseVersionSnapshot          Json // Immutable snapshot of test case at execution
  parentTestCaseVersionAtExecution String? // Version string at execution for sync comparison
  setupVersionSnapshot             Json? // Immutable snapshot of setup used
  resultStatus                     String    @default("NOT_RUN") // NOT_RUN, PASS, FAIL, BLOCKED, SKIPPED, PASSED_WITH_ERRORS
  actualResults                    Json? // JSON or text (legacy)
  notes                            String?   @db.Text
  executedAt                       DateTime?
  isSuspect                        Boolean   @default(false)
  isOutOfSync                      Boolean   @default(false)
  invalidatedAt                    DateTime?
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt

  testRun            VerTestRun                      @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCase           VerTestCase                     @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  nonconformities    VerNonconformity[]
  actualResultBlocks VerTestRunResultActualResult[]
  statusHistory      VerTestRunResultStatusHistory[]

  @@unique([testRunId, testCaseId])
  @@index([testRunId])
  @@index([testCaseId])
  @@index([resultStatus])
  @@index([isOutOfSync])
}

// Rich actual results (append-only)
