model Parameter {
  id                String   @id @default(uuid())
  projectId         String
  parameterId       String? // unique display ID per project (e.g. PARAM-001)
  name              String
  description       String?
  dataType          String?
  defaultValue      String?
  unit              String?
  tolerance         String?
  minValue          String?
  maxValue          String?
  version           String   @default("1.0")
  status            String   @default("draft") // draft | approved | obsolete
  ownerType         String? // component | function | system | team
  tags              Json? // array of strings
  folderId          String?
  sourceParameterId String? // for derived parameters
  formula           String? // optional formula/rule (display or future evaluation)
  enumValues        String? // JSON: [{name,value}] for enum types
  dimensions        String? // shape/size for vector/matrix types, e.g. "3x1", "4x4"
  platforms         Json? // string[] — target keys this param is available for; null = all
  sourceFunctionId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // AI provenance (ai-ready-vision.md §6.1). authorType marks whether a
  // human, an AI suggestion, an accepted AI suggestion, or an applied
  // auto-maintenance action last wrote to the object. Review fields
  // capture who last reviewed this record.
  authorType          String    @default("human")
  authorAiModel       String?
  authorAiVersion     String?
  authorAiPromptId    String?
  authorAiContextHash String?
  reviewStatus        String    @default("reviewed")
  reviewerUserId      String?
  reviewTimestamp     DateTime?

  // ITAR / security classification gate (plan §2.1 item 18). The RAG
  // indexer and MCP search tool exclude itar rows unless the calling
  // key holds an itar scope.
  classification String @default("internal")

  // Optimistic concurrency token (plan §2.1 item 14). Every write
  // compares and bumps. Stale writes rejected with HTTP 409.
  lockVersion Int @default(0)

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceFunction    SystemFunction?    @relation(fields: [sourceFunctionId], references: [id], onDelete: SetNull)
  sourceParameter   Parameter?         @relation("DerivedParameter", fields: [sourceParameterId], references: [id], onDelete: SetNull)
  derivedParameters Parameter[]        @relation("DerivedParameter")
  versions          ParameterVersion[]
  commFields        CommField[]
  folder            ParameterFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([projectId, name])
  @@unique([projectId, parameterId])
  @@index([projectId, status])
  @@index([projectId, folderId])
  @@index([projectId, authorType])
  @@index([projectId, classification])
  @@index([sourceParameterId])
}

model ParameterVersion {
  id           String   @id @default(uuid())
  parameterId  String
  version      Int // major version — increments when parameter is approved
  minorVersion Int      @default(0) // minor version — increments on every non-approval change; resets to 0 on approval
  snapshot     Json // full auditable fields: name, description, dataType, defaultValue, unit, tolerance, minValue, maxValue, status, ownerType, formula, version, etc.
  createdAt    DateTime @default(now())
  createdById  String?

  parameter Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([parameterId])
}

// Per-project custom parameter type registry.
// Built-in types (float32, int32, etc.) are returned statically by the API
// and are not stored here. Only user-defined additions live in this table.
model ParameterType {
  id           String   @id @default(uuid())
  projectId    String
  name         String
  description  String?
