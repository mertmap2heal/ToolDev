model VerTemplateVersion {
  id          String   @id @default(uuid())
  templateId  String
  version     Int
  contentJson Json
  createdAt   DateTime @default(now())

  template VerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

