  translations Json? // { c_header, matlab, python, ada, simulink, ros, dds, autosar, xtce }
  valueFormat  Json? // { template, example, hint, pattern, dimensions, structure }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
}

model ProjectUnit {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  symbol      String
  description String?
  category    String? // e.g. "length", "mass", "custom"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, symbol])
  @@index([projectId])
}

model ParameterFolder {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  projectId   String
  parentId    String?
  order       Int      @default(0)
