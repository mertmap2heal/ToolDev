# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/engineering_tool"

# JWT (required for auth)
JWT_SECRET="your-secret-key"
# JWT_EXPIRES_IN="7d"

# Server
# PORT=5000
# Set to development to see detailed error messages in API 500 responses
# NODE_ENV=development

# Admin: comma-separated emails that have admin access (optional; if unset, first user is admin)
# ADMIN_EMAILS="admin@example.com"

# --- Seed / script passwords (only needed when running seed:users or check-password scripts) ---
# SEED_PASSWORD_MERT=yourpassword
# SEED_PASSWORD_CHRISTIAN=yourpassword
# SEED_PASSWORD_ADMIN=yourpassword
# CHECK_PASSWORD=yourpassword        # used by scripts/check-password.ts

# --- Cleanup job ---
# CLEANUP_ENABLED=true               # set to false to disable scheduled cleanup
# CLEANUP_RETENTION_DAYS=7           # days after soft-delete before permanent deletion
# CLEANUP_BATCH_SIZE=100             # records processed per cleanup run

# --- Backup ---
# BACKUP_RETENTION_DAYS=30           # days to retain daily backups

# --- Invite email (required for "Send invite" to work) ---
# SMTP server
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Optional: URL shown in the invite email (default: http://localhost:3000)
# APP_URL="http://localhost:3000"
# Optional: sender display name (default: Engineering Tool)
# INVITE_FROM_NAME="Engineering Tool"
