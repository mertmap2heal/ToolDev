# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/engineering_tool"

# JWT (required for auth)
JWT_SECRET="your-secret-key"
# JWT_EXPIRES_IN="7d"

# Server
# PORT=5000
# Set to development to see detailed error messages in API 500 responses
# NODE_ENV=development

# Admin: comma-separated emails that have admin access (optional; if unset, first user is admin)
# ADMIN_EMAILS="admin@example.com"

# --- Seed / script passwords (only needed when running seed:users or check-password scripts) ---
# SEED_PASSWORD_MERT=yourpassword
# SEED_PASSWORD_CHRISTIAN=yourpassword
# SEED_PASSWORD_ADMIN=yourpassword
# CHECK_PASSWORD=yourpassword        # used by scripts/check-password.ts

# --- Cleanup job ---
# CLEANUP_ENABLED=true               # set to false to disable scheduled cleanup
# CLEANUP_RETENTION_DAYS=7           # days after soft-delete before permanent deletion
# CLEANUP_BATCH_SIZE=100             # records processed per cleanup run

# --- Backup ---
# BACKUP_RETENTION_DAYS=30           # days to retain daily backups
#
# Off-host backup (S3). Set S3_BACKUP_BUCKET to enable uploading each backup
# to S3 after pg_dump. Required for disaster recovery (local-only backups are
# lost if the host disk fails).
# S3_BACKUP_BUCKET="my-company-backups/engineering-tool"
# AWS_ACCESS_KEY_ID="AKIAxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_DEFAULT_REGION="us-east-1"

# --- Invite email (required for "Send invite" to work) ---
# SMTP server
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Optional: URL shown in the invite email (default: http://localhost:3000)
# APP_URL="http://localhost:3000"
# Optional: sender display name (default: Engineering Tool)
# INVITE_FROM_NAME="Engineering Tool"

# --- E2E test credentials (required for `npm run test:e2e`) ---
# Username and password the Playwright auth.setup.ts logs in with.
# Never commit real credentials. In CI these must be GitHub Actions secrets.
# E2E_USERNAME="your-e2e-test-account"
# E2E_PASSWORD="your-e2e-test-password"

# --- AI features (ai-ready-vision.md; plan §7) ---
# Global kill switch. When "false" (or any non-"true" value), no /ai/*
# routes are reachable, no MCP tools are registered, no AI UI renders.
# Defence / air-gapped customers keep this "false".
# FEATURES_AI_ENABLED="false"
#
# Default LLM provider. Used when no per-project override is set. One of:
#   "anthropic" | "openai" | "self-hosted"
# AI_DEFAULT_PROVIDER="anthropic"
#
# For BYOK (bring-your-own-key): header name the frontend forwards with
# its AI request. Backend reads this header and uses the supplied token
# for that invocation only; the token is never persisted.
# AI_BYOK_HEADER_NAME="X-AI-BYOK"
#
# BYOK at-rest encryption key. SHA-256-hashed into the AES-256-GCM DEK
# used by aiCredentials.service.ts. Rotating this value orphans every
# stored credential (by design - users must re-paste their keys).
# In production use a managed KMS (Vault / AWS KMS / Azure Key Vault)
# instead of an env var. Falls back to JWT_SECRET if unset (dev only).
# AI_CREDENTIAL_KEY="change-me-to-a-32+-char-random-string"
#
# For self-hosted LLM endpoint (customer VPC / on-prem).
# AI_SELF_HOSTED_URL="https://llm.internal.example.com/v1"
#
# Hosted-default provider API key (plan Option C). Only read when the
# request doesn't carry a BYOK header and the user has no stored
# UserAiCredential. Keep out of the frontend bundle (never VITE_*).
# ANTHROPIC_API_KEY="sk-ant-api03-..."
# OPENAI_API_KEY="sk-..."
