# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/engineering_tool"

# JWT (required for auth)
JWT_SECRET="your-secret-key"
# JWT_EXPIRES_IN="7d"

# Server
# PORT=5000

# Admin: comma-separated emails that have admin access (optional; if unset, first user is admin)
# ADMIN_EMAILS="admin@example.com"

# --- Invite email (required for "Send invite" to work) ---
# SMTP server
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Optional: URL shown in the invite email (default: http://localhost:3000)
# APP_URL="http://localhost:3000"
# Optional: sender display name (default: Engineering Tool)
# INVITE_FROM_NAME="Engineering Tool"
