# Database (required)
DATABASE_URL="postgresql://user:password@localhost:5432/engineering_tool"

# JWT (required for auth)
JWT_SECRET="your-secret-key"
# JWT_EXPIRES_IN="7d"

# Server
# PORT=5000
# Set to development to see detailed error messages in API 500 responses
# NODE_ENV=development

# Admin: comma-separated emails that have admin access (optional; if unset, first user is admin)
# ADMIN_EMAILS="admin@example.com"

# --- Invite email (required for "Send invite" to work) ---
# SMTP server
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
# Optional: URL shown in the invite email (default: http://localhost:3000)
# APP_URL="http://localhost:3000"
# Optional: sender display name (default: Engineering Tool)
# INVITE_FROM_NAME="Engineering Tool"

# --- E2E test credentials (required for `npm run test:e2e`) ---
# Username and password the Playwright auth.setup.ts logs in with.
# Never commit real credentials. In CI these must be GitHub Actions secrets.
# E2E_USERNAME="your-e2e-test-account"
# E2E_PASSWORD="your-e2e-test-password"
